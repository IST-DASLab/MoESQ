+# The paired-4:8 NVFP4 MoE kernels ship as a separate extension wheel
+# (PAIRED_NVFP4_KERNELS_URL). Importing the package registers
+# torch.ops.paired_nvfp4.*. vLLM stays importable without it — the import is
+# triggered lazily on first op use.
+PAIRED_NVFP4_KERNELS_PKG = "paired_nvfp4_kernels"
+PAIRED_NVFP4_KERNELS_URL = "https://github.com/IST-DASLab/grouped-sparse-GEMM"
+# The kernel release this integration is pinned to (install from this tag).
+# Older wheels still load on SM100 (optional features are probed
+# individually), but only >= this version is validated against this
+# integration, and SM120 needs it: 0.12.0 completes the SM120 port (tiles,
+# arch-aware default tactic, cluster rules and suggest_tactic).
+PAIRED_NVFP4_KERNELS_TAG = "v0.12.0"
+PAIRED_NVFP4_KERNELS_MIN_VERSION = "0.12.0"
+# Arches with a paired-4:8 sparse NVFP4 kernel (PAIRED_NVFP4_ARCHS 100a / 120a).
+PAIRED_NVFP4_SUPPORTED_ARCHS = (100, 120)
+# group_mm default tactic of wheels that predate DEFAULT_TACTIC (SM100 only).
+_PAIRED_NVFP4_LEGACY_DEFAULT_TACTIC = (0, 2, 1)
+_paired_nvfp4_loaded = False
+
+
+def _as_sf_bytes(sf: torch.Tensor) -> torch.Tensor:
+    """Reinterpret an fp8-e4m3 scale-factor tensor as raw uint8 bytes.
+
+    The kernel bindings consume block/activation scale factors as raw ue4m3
+    bytes, while vLLM carries them as the bit-identical ``torch.float8_e4m3fn``.
+    This is a zero-copy reinterpret; uint8 inputs pass through unchanged.
+    """
+    if sf.dtype == torch.float8_e4m3fn:
+        return sf.view(torch.uint8)
+    return sf
+
+
+def _ensure_paired_nvfp4_kernels() -> None:
+    global _paired_nvfp4_loaded
+    if _paired_nvfp4_loaded:
+        return
+    try:
+        import importlib
+
+        mod = importlib.import_module(PAIRED_NVFP4_KERNELS_PKG)
+    except ImportError as e:
+        raise ImportError(
+            f"paired-4:8 NVFP4 MoE kernels ('{PAIRED_NVFP4_KERNELS_PKG}') are not "
+            "installed. They are required by moe_backend='paired48_nvfp4' and by "
+            "group_size=32 NVFP4 MoE checkpoints; build and install them from "
+            f"{PAIRED_NVFP4_KERNELS_URL}."
+        ) from e
+    from packaging.version import Version
+
+    # Compare as versions, not strings: v0.10.0 wheels report "0.1.0".
+    version = getattr(mod, "__version__", None)
+    outdated = version is None or Version(version) < Version(
+        PAIRED_NVFP4_KERNELS_MIN_VERSION
+    )
+    _check_paired_nvfp4_arch(mod, version, outdated)
+    if outdated:
+        logger.warning_once(
+            "%s %s is older than the validated %s; upgrade to tag %s of %s.",
+            PAIRED_NVFP4_KERNELS_PKG,
+            version,
+            PAIRED_NVFP4_KERNELS_MIN_VERSION,
+            PAIRED_NVFP4_KERNELS_TAG,
+            PAIRED_NVFP4_KERNELS_URL,
+        )
+    _paired_nvfp4_loaded = True
+
+
+def _check_paired_nvfp4_arch(mod, version: str | None, outdated: bool) -> None:
+    """Fail loudly if the installed wheel cannot run on the current device.
+
+    The package loads the extension module built for the current SM, or else
+    the first one built, which registers the same ops but whose kernels do not
+    run on this device (e.g. a PAIRED_NVFP4_ARCHS=100a wheel on an RTX PRO
+    6000). Without a CUDA device (import-time checks) nothing is enforced.
+    """
+    if not torch.cuda.is_available():
+        return
+    major, minor = torch.cuda.get_device_capability()
+    sm = major * 10 + minor
+    rebuild = (
+        f"Rebuild {PAIRED_NVFP4_KERNELS_PKG} {PAIRED_NVFP4_KERNELS_TAG} from "
+        f"{PAIRED_NVFP4_KERNELS_URL} with PAIRED_NVFP4_ARCHS={sm}a (or "
+        f'"100a;120a" for one wheel covering both).'
+    )
+    if not hasattr(mod, "loaded_arch"):
+        # Wheels before the SM120 backend only carry SM100 kernels.
+        if sm != 100:
+            raise RuntimeError(
+                f"{PAIRED_NVFP4_KERNELS_PKG} {version} only supports SM100; the "
+                f"current device is SM{sm}. {rebuild}"
+            )
+        return
+    built = list(mod.built_archs())
+    if sm not in built:
+        supported = ", ".join(f"SM{a}" for a in PAIRED_NVFP4_SUPPORTED_ARCHS)
+        hint = (
+            rebuild
+            if sm in PAIRED_NVFP4_SUPPORTED_ARCHS
+            else f"The paired-4:8 sparse NVFP4 kernels support {supported} only."
+        )
+        raise RuntimeError(
+            f"{PAIRED_NVFP4_KERNELS_PKG} {version} was built for "
+            f"{', '.join(f'SM{a}' for a in built)}; the current device is "
+            f"SM{sm}. {hint}"
+        )
+    if sm != 100 and outdated:
+        raise RuntimeError(
+            f"{PAIRED_NVFP4_KERNELS_PKG} {version} predates the completed SM{sm} "
+            f"port; SM{sm} needs >= {PAIRED_NVFP4_KERNELS_MIN_VERSION}. Install "
+            f"tag {PAIRED_NVFP4_KERNELS_TAG} from {PAIRED_NVFP4_KERNELS_URL}."
+        )
+
+
+def paired_nvfp4_available() -> bool:
+    """True iff the external paired-4:8 NVFP4 kernel ops are importable."""
+    try:
+        _ensure_paired_nvfp4_kernels()
+    except ImportError:
+        return False
+    return hasattr(torch.ops, "paired_nvfp4")
+
+
+def paired_nvfp4_supports_tactics() -> bool:
+    """True iff the installed kernel wheel exposes the autotuning
+    tactic surface: a ``group_mm_configs`` op plus ``config_id``/``cluster_m``/
+    ``cluster_n`` arguments on ``group_mm``."""
+    if not paired_nvfp4_available():
+        return False
+    return hasattr(torch.ops.paired_nvfp4, "group_mm_configs")
+
+
+def paired_nvfp4_group_mm_configs() -> list[str]:
+    """config_id-ordered names of the wheel's compiled group_mm tile variants."""
+    _ensure_paired_nvfp4_kernels()
+    return list(torch.ops.paired_nvfp4.group_mm_configs())
+
+
+def paired_nvfp4_default_tactic() -> tuple[int, int, int]:
+    """The kernel's default group_mm tactic for the loaded arch, i.e. what
+    ``tactic=None`` runs: ``(0, 2, 1)`` (sparse_2sm_256x128, cluster 2x1) on
+    SM100, ``(2, 1, 1)`` (sparse_1sm_128x64; clusters are always 1x1) on SM120.
+    Tactic ids and clusters are arch-specific, so never hard-code them."""
+    _ensure_paired_nvfp4_kernels()
+    import paired_nvfp4_kernels
+
+    return tuple(
+        getattr(
+            paired_nvfp4_kernels, "DEFAULT_TACTIC", _PAIRED_NVFP4_LEGACY_DEFAULT_TACTIC
+        )
+    )
+
+
+@functools.cache
+def paired_nvfp4_suggest_tactic(max_n: int) -> tuple[int, int, int] | None:
+    """The kernel's untuned tactic pick for a per-expert capacity ``max_n``
+    (SM120: sparse_1sm_256x128 for prefill-sized capacities, else the default;
+    SM100: the default). None (the op default) on wheels without
+    ``suggest_tactic``. Cached: it is looked up on the host every forward."""
+    _ensure_paired_nvfp4_kernels()
+    import paired_nvfp4_kernels
+
+    suggest = getattr(paired_nvfp4_kernels, "suggest_tactic", None)
+    return None if suggest is None else tuple(suggest(max_n))
+
+
+def paired_nvfp4_moe_mm(
+    out_tensors: torch.Tensor,
+    w_comp: torch.Tensor,
+    w_meta: torch.Tensor,
+    w_scales: torch.Tensor,
+    a_tensors: torch.Tensor,
+    a_scales: torch.Tensor,
+    alphas: torch.Tensor,
+    expert_num_tokens: torch.Tensor,
+    features: int,
+    k: int,
+    tactic: tuple[int, int, int] | None = None,
+):
+    """Paired-4:8 NVFP4 (W4A4) batched sparse grouped GEMM for MoE experts
+    (SM100 / SM120).
+
+    Batched (``[E, max_n, *]``) — the sparse block-scaled collective slices each
+    expert's operands at ``e * max_n * k``, so tokens live in fixed ``max_n``
+    capacity slots. Per expert ``e`` over its first ``expert_num_tokens[e]`` rows:
+        ``out[e, :count] = alphas[e] * (w_comp[e] @ a_tensors[e, :count])``
+    The weight is the compressed structured-sparse A operand (+ metadata
+    ``w_meta``); activations are the dense B operand. ``w_scales`` is in SFA
+    layout, ``a_scales`` in SFB layout.
+
+    ``tactic`` is an optional autotuning triple ``(config_id, cluster_m,
+    cluster_n)``: the compiled MMA tile variant and the dynamic runtime cluster,
+    if the installed wheel provides it (see ``paired_nvfp4_supports_tactics``).
+    ``None`` uses the kernel's default tactic for the loaded arch
+    (``paired_nvfp4_default_tactic``) and works with wheels without tactic
+    support.
+    """
+    _ensure_paired_nvfp4_kernels()
+    tactic_args = () if tactic is None else tuple(tactic)
+    return torch.ops.paired_nvfp4.group_mm(
+        out_tensors,
+        w_comp,
+        w_meta,
+        _as_sf_bytes(w_scales),
+        a_tensors,
+        _as_sf_bytes(a_scales),
+        alphas,
+        expert_num_tokens,
+        features,
+        k,
+        *tactic_args,
+    )
+
+
+def paired_nvfp4_quant_act(
+    x: torch.Tensor,
+    gscale: torch.Tensor,
+    expert_num_tokens: torch.Tensor,
+    features: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Batched NVFP4 activation quant emitting the sparse kernel's SFB layout.
+
+    Quantizes bf16 ``x [E, max_n, K]`` per 32-element K block (the sparse MMA's
+    SFVecSize=32): ``bsf = amax/6``, ``b_act = e2m1(x / bsf)``, ``sfb =
+    ue4m3(bsf * gscale[e])`` — the FlashInfer convention ``b_act * sfb ~=
+    x * gscale``, so the per-expert GEMM ``alphas`` are unchanged. Returns
+    ``(b_act [E, max_n, K/2] uint8, sfb flat uint8)`` with ``sfb`` swizzled
+    byte-identically to what ``group_mm`` reads; ``features`` must equal the
+    consuming GEMM's ``features`` (it parametrizes the SFB layout). Rows past
+    ``expert_num_tokens[e]`` get a benign nonzero SF and an UNDEFINED ``b_act``:
+    the op skips their store, and ``group_mm`` clips each expert to
+    ``expert_num_tokens[e]`` so those bytes are never read. Callers must neither
+    pre-fill nor read padded ``b_act`` rows. Capture-safe.
+    """
+    _ensure_paired_nvfp4_kernels()
+    return torch.ops.paired_nvfp4.quant_act(x, gscale, expert_num_tokens, features)
+
+
+def paired_nvfp4_supports_fused_silu_quant() -> bool:
+    """True iff the installed kernel wheel exposes the fused
+    SwiGLU+quant op ``silu_mul_quant_act`` (GEMM2-input fusion)."""
+    if not paired_nvfp4_available():
+        return False
+    return hasattr(torch.ops.paired_nvfp4, "silu_mul_quant_act")
+
+
+def paired_nvfp4_silu_mul_quant_act(
+    x2: torch.Tensor,
+    gscale: torch.Tensor,
+    expert_num_tokens: torch.Tensor,
+    features: int,
+    interleaved: bool = False,
+    act: tuple[str, float, float] | None = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Fused SwiGLU + NVFP4 activation quant for GEMM2's input (sparse SFB layout).
+
+    ``act`` = ``(activation, beta, linear_beta)`` selects the gated activation
+    (``paired_nvfp4_gated_act``); None is SwiGLU. ``("situ", beta, linear_beta)``
+    is bit-identical to ``situ_and_mul`` followed by ``paired_nvfp4_quant_act``
+    and needs a wheel with ``paired_nvfp4_supports_situ``.
+
+    ``x2 [E, max_n, 2N]`` is GEMM1's bf16 output (gate|up halves, vLLM
+    ``silu_and_mul`` convention). One kernel computes ``silu(gate) * up`` and
+    quantizes it per 32-element block, replacing the unfused 3-kernel chain
+    ``silu_and_mul -> paired_nvfp4_quant_act`` and its bf16 ``[E, max_n, N]``
+    intermediate round trip. BIT-IDENTICAL to that chain by construction (the
+    kernel replicates vLLM's exact silu rounding; gated by the wheel's
+    ``selftest_silu_mul_quant``). Returns ``(b_act [E, max_n, N/2] uint8, sfb
+    flat uint8)``; ``features`` must equal GEMM2's ``features``. Same padding
+    contract as ``paired_nvfp4_quant_act``: rows past ``expert_num_tokens[e]``
+    get a benign nonzero SF and an undefined ``b_act`` that ``group_mm`` never
+    reads, so bit-identity with the unfused chain holds on VALID rows.
+    Capture-safe. Only if the installed wheel provides it
+    (``paired_nvfp4_supports_fused_silu_quant``).
+    """
+    _ensure_paired_nvfp4_kernels()
+    if act is not None and act[0] != "silu":
+        return torch.ops.paired_nvfp4.silu_mul_quant_act(
+            x2, gscale, expert_num_tokens, features, interleaved, *act
+        )
+    if interleaved:  # GEMM1 ran on interleaved W13 rows (paired_nvfp4_interleave_w13)
+        return torch.ops.paired_nvfp4.silu_mul_quant_act(
+            x2, gscale, expert_num_tokens, features, True
+        )
+    return torch.ops.paired_nvfp4.silu_mul_quant_act(
+        x2, gscale, expert_num_tokens, features
+    )
+
+
+def paired_nvfp4_supports_situ() -> bool:
+    """True iff the installed kernel wheel's gated-activation ops take
+    ``activation="situ"`` (Kimi SiTU-GLU), in ``silu_mul_quant_act`` and, where
+    the arch has it, the fused ``group_mm_swiglu_quant`` epilogue."""
+    if not paired_nvfp4_available():
+        return False
+    op = getattr(torch.ops.paired_nvfp4, "silu_mul_quant_act", None)
+    if op is None:
+        return False
+    return any(
+        a.name == "activation" for a in op.default._schema.arguments
+    )
+
+
+def paired_nvfp4_gated_act(
+    activation, situ_beta: float | None, situ_linear_beta: float | None
+) -> tuple[str, float, float]:
+    """``(activation, beta, linear_beta)`` for the paired48 gated-activation ops,
+    from a MoEActivation and the layer's SituGLU parameters (vLLM's defaults:
+    beta 1.0, no up softcap)."""
+    name = str(getattr(activation, "value", activation))
+    if name == "situ":
+        return (
+            "situ",
+            float(situ_beta) if situ_beta else 1.0,
+            float(situ_linear_beta) if situ_linear_beta else -1.0,
+        )
+    assert name == "silu", f"paired48_nvfp4: unsupported activation {name}"
+    return ("silu", 1.0, -1.0)
+
+
+def paired_nvfp4_supports_fused_swiglu() -> bool:
+    """True iff the installed kernel wheel has the GEMM1 epilogue with SwiGLU and
+    GEMM2's input quantization fused in (``group_mm_swiglu_quant``) for this arch,
+    and the interleaved ``silu_mul_quant_act`` that shares its weight order."""
+    if not paired_nvfp4_available():
+        return False
+    ns = torch.ops.paired_nvfp4
+    return hasattr(ns, "group_mm_swiglu_quant") and bool(
+        list(ns.group_mm_swiglu_configs())
+    )
+
+
+def paired_nvfp4_group_mm_swiglu_configs() -> list[str]:
+    _ensure_paired_nvfp4_kernels()
+    return list(torch.ops.paired_nvfp4.group_mm_swiglu_configs())
+
+
+def paired_nvfp4_interleave_w13(n: int, device: torch.device) -> torch.Tensor:
+    """Row order of W13 ([gate; up], 2n rows) for the fused SwiGLU epilogue:
+    64-row blocks of 32 gate rows followed by the matching 32 up rows."""
+    assert n % 64 == 0, f"intermediate size must be a multiple of 64, got {n}"
+    gate = torch.arange(n, device=device).view(-1, 32)
+    return torch.stack([gate, gate + n], dim=1).reshape(-1)
+
+
+def paired_nvfp4_group_mm_swiglu_quant(
+    w_comp: torch.Tensor,
+    w_meta: torch.Tensor,
+    w_sf: torch.Tensor,
+    a_fp4: torch.Tensor,
+    a_sf: torch.Tensor,
+    alphas: torch.Tensor,
+    expert_num_tokens: torch.Tensor,
+    gscale2: torch.Tensor,
+    features: int,
+    k: int,
+    tactic: tuple[int, int, int],
+    act: tuple[str, float, float] | None = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """GEMM1 on interleaved W13 with SwiGLU and GEMM2's input quantization in the
+    epilogue: returns GEMM2's ``(b_act, sfb)``, byte-identical to GEMM1 followed by
+    ``paired_nvfp4_silu_mul_quant_act(..., interleaved=True)``. ``features`` is
+    GEMM1's M (2N)."""
+    _ensure_paired_nvfp4_kernels()
+    extra = tuple(act) if act is not None and act[0] != "silu" else ()
+    return torch.ops.paired_nvfp4.group_mm_swiglu_quant(
+        w_comp, w_meta, w_sf, a_fp4, a_sf, alphas, expert_num_tokens, gscale2,
+        features, k, *tactic, *extra,
+    )
+
+
+def paired_nvfp4_supports_scatter_quant() -> bool:
+    """True iff the installed kernel wheel exposes the fused
+    dispatch-scatter + quant op ``scatter_quant_act`` (GEMM1-input fusion)."""
+    if not paired_nvfp4_available():
+        return False
+    return hasattr(torch.ops.paired_nvfp4, "scatter_quant_act")
+
+
+def paired_nvfp4_scatter_quant_act(
+    a1: torch.Tensor,
+    flat_tok: torch.Tensor,
+    dest_global: torch.Tensor,
+    topk_weights: torch.Tensor | None,
+    gscale: torch.Tensor,
+    expert_num_tokens: torch.Tensor,
+    cap: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Fused dispatch-scatter + NVFP4 activation quant for GEMM1's input.
+
+    Consumes the CaptureSafe batched dispatch plan directly: for each routed
+    entry, reads the token's bf16 row from TOKEN-ORDER ``a1 [T, K]``, quantizes
+    per 32-element block, and writes FP4 + SFB straight into the batched
+    ``[E, cap, ...]`` operands at ``dest_global`` (trash row ``E*cap`` absorbs
+    non-local / overflow routings). Replaces ``index_select`` + ``index_copy_``
+    + ``quant_act`` — neither bf16 intermediate is materialized, and the work
+    scales with routed tokens (T*topk), not capacity (E*cap). Valid rows are
+    BYTE-IDENTICAL to that chain (wheel ``selftest_scatter_quant``); padded
+    rows hold garbage b_act (never read — the GEMM clips at counts) and a
+    benign nonzero SF fill. ``topk_weights`` (flat ``[T*topk]`` f32 or None)
+    applies router weights on input with torch-exact bf16 rounding.
+    Capture-safe. Only if the installed wheel provides it
+    (``paired_nvfp4_supports_scatter_quant``).
+    """
+    _ensure_paired_nvfp4_kernels()
+    return torch.ops.paired_nvfp4.scatter_quant_act(
+        a1, flat_tok, dest_global, topk_weights, gscale, expert_num_tokens, cap
+    )
+
+
+def paired_nvfp4_supports_fused_dispatch() -> bool:
+    """True iff the installed kernel wheel exposes the fused dispatch plan and
+    combine (``dispatch_plan``, ``scatter_quant_act_planned``, ``moe_finalize``)."""
+    if not paired_nvfp4_available():
+        return False
+    ns = torch.ops.paired_nvfp4
+    return all(
+        hasattr(ns, op)
+        for op in ("dispatch_plan", "scatter_quant_act_planned", "moe_finalize")
+    )
+
+
+def paired_nvfp4_dispatch_plan(
+    topk_ids: torch.Tensor,
+    first_expert: int,
+    num_local_experts: int,
+    cap: int,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Batched dispatch plan for this rank's contiguous expert shard.
+
+    Returns ``(expert_num_tokens i32 [E], route_dest i32 [T, topk],
+    src_tok i32 [E*cap], src_route i32 [E*cap])``. A kept routing lands in row
+    ``e*cap + r`` with ``r`` its stable rank among this rank's routings to
+    ``e`` (the rank the torch argsort plan computes); ``route_dest`` is -1 for
+    routings to other ranks' experts or past ``cap``. One launch up to 1024
+    routings, three above. Deterministic and capture-safe. Only if the wheel
+    provides it (``paired_nvfp4_supports_fused_dispatch``).
+    """
+    _ensure_paired_nvfp4_kernels()
+    return torch.ops.paired_nvfp4.dispatch_plan(
+        topk_ids, first_expert, num_local_experts, cap
+    )
+
+
+def paired_nvfp4_scatter_quant_act_planned(
+    a1: torch.Tensor,
+    src_tok: torch.Tensor,
+    src_route: torch.Tensor,
+    topk_weights: torch.Tensor | None,
+    gscale: torch.Tensor,
+    expert_num_tokens: torch.Tensor,
+    cap: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """``paired_nvfp4_scatter_quant_act`` over a ``paired_nvfp4_dispatch_plan``:
+    same bytes on every valid row, but only the kept rows do work (under EP most
+    routings belong to other ranks)."""
+    _ensure_paired_nvfp4_kernels()
+    return torch.ops.paired_nvfp4.scatter_quant_act_planned(
+        a1, src_tok, src_route, topk_weights, gscale, expert_num_tokens, cap
+    )
+
+
+def paired_nvfp4_supports_prequant_dispatch() -> bool:
+    """True iff the wheel can quantize token rows before an all2all
+    (``quant_rows``) and scatter the received FP4 rows (``scatter_fp4_planned``)."""
+    if not paired_nvfp4_supports_fused_dispatch():
+        return False
+    ns = torch.ops.paired_nvfp4
+    return hasattr(ns, "quant_rows") and hasattr(ns, "scatter_fp4_planned")
+
+
+def paired_nvfp4_quant_rows(
+    x: torch.Tensor, gscale: torch.Tensor
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Token rows ``[T, K]`` -> e2m1 ``[T, K/2]`` + linear group-32 scales
+    ``[T, K/32]`` with the shared global scale ``gscale[0]``."""
+    _ensure_paired_nvfp4_kernels()
+    return torch.ops.paired_nvfp4.quant_rows(x, gscale)
+
+
+def paired_nvfp4_scatter_fp4_planned(
+    q: torch.Tensor,
+    q_sf: torch.Tensor,
+    src_tok: torch.Tensor,
+    expert_num_tokens: torch.Tensor,
+    cap: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Place ``quant_rows`` output into GEMM1's batched operands via a
+    ``paired_nvfp4_dispatch_plan``. Byte-identical to
+    ``paired_nvfp4_scatter_quant_act_planned`` on the bf16 rows."""
+    _ensure_paired_nvfp4_kernels()
+    return torch.ops.paired_nvfp4.scatter_fp4_planned(
+        q, q_sf, src_tok, expert_num_tokens, cap
+    )
+
+
+def paired_nvfp4_moe_finalize(
+    out: torch.Tensor,
+    fused_expert_output: torch.Tensor,
+    route_dest: torch.Tensor,
+    topk_weights: torch.Tensor | None,
+) -> None:
+    """Combine the batched ``[E, cap, K]`` expert output into token-order
+    ``out [T, K]``: ``out[t] = sum_k bf16(row * bf16(w[t, k]))`` over kept
+    routings, fp32 in top-k order. Bit-identical to index_select + bf16 multiply
+    + fp32 sum; never reads padded rows. ``topk_weights=None`` when the router
+    weight was applied on the input."""
+    _ensure_paired_nvfp4_kernels()
+    torch.ops.paired_nvfp4.moe_finalize(
+        out, fused_expert_output, route_dest, topk_weights
+    )
+
+
+def paired_nvfp4_compress(
+    w_packed: torch.Tensor,
+    w_blockscale: torch.Tensor,
+    k: int,
+):
+    """One-time load-side compression of a dense packed-NVFP4 expert weight.
+
+    Returns ``(w_comp, w_meta, w_sf)`` — the structured-sparse compressed weight,
+    its sparsity metadata, and the block scales re-laid into SFA layout. Operates
+    on the dense packed weight (sparse-storage checkpoints are rebuilt to dense
+    first).
+    """
+    _ensure_paired_nvfp4_kernels()
+    # The kernel binding consumes block scales as raw bytes (ue4m3); vLLM carries
+    # them as the bit-identical torch.float8_e4m3fn. Reinterpret at the boundary.
+    return torch.ops.paired_nvfp4.compress(w_packed, _as_sf_bytes(w_blockscale), k)
+
+
 def cutlass_mxfp4_moe_mm(
     out_tensors: torch.Tensor,
     a_tensors: torch.Tensor,
