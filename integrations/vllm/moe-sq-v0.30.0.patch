@@ -0,0 +1,467 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Startup autotuner for the paired-4:8 NVFP4 sparse grouped GEMM (SM100/SM120).
+
+Runs inside ``kernel_warmup()`` — after weights are loaded and compressed,
+strictly before CUDA-graph capture — and follows the DeepGEMM warmup pattern:
+walk the model for MoE layers using the ``paired48_nvfp4`` backend, then time
+``torch.ops.paired_nvfp4.group_mm`` directly over the REAL compressed weights
+for every candidate tactic ``(config_id, cluster_m, cluster_n)``. No
+collectives are issued, so this cannot deadlock under TP/EP/DP (each rank
+tunes independently, like the FlashInfer autotuner; tactic
+divergence across ranks affects only per-rank step time, never correctness).
+
+The batched kernel ABI makes the problem shape ``[E_local, max_n, ...]``; the
+capture-safe dispatch sizes ``max_n`` dynamically (``min(max_num_tokens, T)``),
+so each GEMM geometry (gate_up and down) is tuned at two capacities: the full
+one (prefill) and the largest CUDA-graph capture size (decode). The whole sweep
+takes seconds. Tactics are frozen on the experts objects before capture; the
+tactic lookup at apply-time is pure CPU state keyed on the host-side ``max_n``
+(fixed per captured graph), so it is capture-safe.
+
+A correctness gate compares every candidate against the default tactic's
+output and rejects mismatches — latency-only autotuners can silently ship a
+fast-but-wrong variant.
+"""
+
+import math
+
+import torch
+
+import vllm._custom_ops as ops
+from vllm.logger import init_logger
+from vllm.model_executor.layers.fused_moe.experts.paired48_nvfp4_moe import (
+    Paired48Nvfp4ExpertsModular,
+)
+
+logger = init_logger(__name__)
+
+# The reference/fallback tactic is the kernel's default for the loaded arch
+# (ops.paired_nvfp4_default_tactic): tactic ids and clusters differ between
+# SM100 ((0, 2, 1), sparse_2sm_256x128 2x1) and SM120 ((2, 1, 1),
+# sparse_1sm_128x64; 1x1 clusters only), so nothing here hard-codes one.
+
+# Two-stage budget (triton do_bench takes milliseconds of measurement budget):
+# screen everything cheaply, re-time the finalists properly.
+_SCREEN_MS = 10
+_FINAL_MS = 100
+_TOPK_FINALISTS = 3
+
+# Candidate outputs must match the default tactic's output on the valid rows.
+# Tiles and clusters keep the K-reduction order; SM120 split-K (``_sk``) sums in a
+# different fp32 order. Either way only bf16-level wiggle room, so allclose.
+_GATE_RTOL = 2**-7
+_GATE_ATOL = 1e-2
+
+
+def _valid_clusters(config_name: str) -> list[tuple[int, int]]:
+    """Legal (cluster_m, cluster_n) for one tile variant.
+
+    The kernel package knows the rules of the arch it loaded (SM120 kernels
+    only take a 1x1 cluster); wheels without ``valid_clusters`` get the SM100
+    rules the kernel-side TORCH_CHECKs enforce: dims are powers of two <= 4,
+    product <= 16, and 2SM kernels ("sparse_2sm_*") need an even cluster_m.
+    """
+    try:
+        import paired_nvfp4_kernels
+
+        return list(paired_nvfp4_kernels.valid_clusters(config_name))
+    except (ImportError, AttributeError):
+        pass
+    two_sm = config_name.split("_")[1] == "2sm"
+    out = []
+    for cm in (1, 2, 4):
+        if two_sm and cm % 2 != 0:
+            continue
+        for cn in (1, 2, 4):
+            if cm * cn <= 16:
+                out.append((cm, cn))
+    return out
+
+
+def _all_tactics() -> list[tuple[int, int, int]]:
+    tactics = []
+    for config_id, name in enumerate(ops.paired_nvfp4_group_mm_configs()):
+        for cm, cn in _valid_clusters(name):
+            tactics.append((config_id, cm, cn))
+    return tactics
+
+
+def _bench(fn, budget_ms: int) -> float:
+    from triton.testing import do_bench
+
+    return float(do_bench(fn, warmup=3, rep=budget_ms))
+
+
+def _tune_one_gemm(
+    *,
+    w_comp: torch.Tensor,
+    w_meta: torch.Tensor,
+    w_sf: torch.Tensor,
+    alphas: torch.Tensor,
+    gscale: torch.Tensor,
+    features: int,
+    contraction: int,
+    max_n: int,
+    counts: torch.Tensor,
+    tactics: list[tuple[int, int, int]],
+    label: str,
+) -> tuple[int, int, int]:
+    """Sweep all tactics for one grouped GEMM over the real weights.
+
+    Returns the fastest tactic that passes the correctness gate (the default
+    tactic on any failure). Transient buffers are freed by the caller scope.
+    """
+    default_tactic = ops.paired_nvfp4_default_tactic()
+    e = w_comp.shape[0]
+    device = w_comp.device
+    x = torch.randn(e, max_n, contraction, dtype=torch.bfloat16, device=device)
+    a_fp4, a_sf = ops.paired_nvfp4_quant_act(x, gscale, counts, features)
+    del x
+    out = torch.empty(e, max_n, features, dtype=torch.bfloat16, device=device)
+
+    def run(tactic):
+        ops.paired_nvfp4_moe_mm(
+            out,
+            w_comp,
+            w_meta,
+            w_sf,
+            a_fp4,
+            a_sf,
+            alphas,
+            counts,
+            features,
+            contraction,
+            tactic=tactic,
+        )
+
+    # Reference output from the default tactic (gates every candidate). Only
+    # the first counts[e] rows are written; padded rows hold garbage. NaN-fill
+    # first so under-writing is visible (the epilogue never loads C; beta=0).
+    cnt = int(counts[0].item())
+    out.fill_(float("nan"))
+    run(default_tactic)
+    torch.cuda.synchronize()
+    ref = out[:, :cnt, :].clone()
+    if ref.isnan().any():
+        logger.warning(
+            "paired_nvfp4 %s: default tactic left NaN in valid rows — "
+            "skipping autotune for this geometry.",
+            label,
+        )
+        return default_tactic
+
+    screened: list[tuple[float, tuple[int, int, int]]] = []
+    for tactic in tactics:
+        # Poison the buffer so a tactic that UNDER-writes valid rows (skipped
+        # tiles / zero work) cannot pass the gate on stale values left by the
+        # previous run — it would also bench fastest and win.
+        out.fill_(float("nan"))
+        try:
+            run(tactic)  # eager probe: skip launch-failing combos cleanly
+            torch.cuda.synchronize()
+        except Exception as exc:  # can_implement reject / launch failure
+            logger.debug("paired_nvfp4 %s: skip tactic %s (%s)", label, tactic, exc)
+            continue
+        if not torch.allclose(out[:, :cnt, :], ref, rtol=_GATE_RTOL, atol=_GATE_ATOL):
+            logger.warning(
+                "paired_nvfp4 %s: tactic %s FAILED the correctness gate vs the "
+                "default tactic — rejected.",
+                label,
+                tactic,
+            )
+            continue
+        screened.append((_bench(lambda t=tactic: run(t), _SCREEN_MS), tactic))
+
+    if not screened:
+        logger.warning(
+            "paired_nvfp4 %s: no tactic passed screening; keeping the default.",
+            label,
+        )
+        return default_tactic
+
+    finalists = sorted(screened)[:_TOPK_FINALISTS]
+
+    # The frozen tactic must be valid at EVERY per-expert capacity, not just
+    # the tuned geometry: with capacity capped at the capture size
+    # (CaptureSafeBatchedPrepareAndFinalize), decode graphs run group_mm at
+    # max_n as small as 1, and a can_implement reject there would abort CUDA-
+    # graph capture. Probe finalists at a tiny capacity and drop failures.
+    x_s = torch.randn(e, 8, contraction, dtype=torch.bfloat16, device=device)
+    cnt_s = torch.ones(e, dtype=torch.int32, device=device)
+    aq_s, sf_s = ops.paired_nvfp4_quant_act(x_s, gscale, cnt_s, features)
+    out_s = torch.empty(e, 8, features, dtype=torch.bfloat16, device=device)
+
+    def small_ok(tactic) -> bool:
+        try:
+            ops.paired_nvfp4_moe_mm(
+                out_s,
+                w_comp,
+                w_meta,
+                w_sf,
+                aq_s,
+                sf_s,
+                alphas,
+                cnt_s,
+                features,
+                contraction,
+                tactic=tactic,
+            )
+            torch.cuda.synchronize()
+            return True
+        except Exception as exc:
+            logger.info(
+                "paired_nvfp4 %s: finalist %s rejected (fails at small capacity: %s)",
+                label,
+                tactic,
+                exc,
+            )
+            return False
+
+    finalists = [(ms, t) for ms, t in finalists if small_ok(t)]
+    if not finalists:
+        logger.warning(
+            "paired_nvfp4 %s: no finalist valid at small capacity; keeping "
+            "the default.",
+            label,
+        )
+        return default_tactic
+
+    timed = [
+        (_bench(lambda t=tactic: run(t), _FINAL_MS), tactic) for _, tactic in finalists
+    ]
+    best_ms, best = min(timed)
+    default_ms = next((ms for ms, t in screened if t == default_tactic), float("nan"))
+    logger.info(
+        "paired_nvfp4 %s: best tactic %s (%.1f us; default %s screened at "
+        "%.1f us; %d/%d tactics valid)",
+        label,
+        best,
+        best_ms * 1e3,
+        default_tactic,
+        default_ms * 1e3,
+        len(screened),
+        len(tactics),
+    )
+    return best
+
+
+def paired48_experts(model: torch.nn.Module) -> list[Paired48Nvfp4ExpertsModular]:
+    """The paired48_nvfp4 experts impls actually selected for this model.
+
+    Covers both an explicit moe_backend="paired48_nvfp4" and the oracle's
+    group_size=32 auto-select under moe_backend="auto".
+    """
+    experts: list[Paired48Nvfp4ExpertsModular] = []
+    for module in model.modules():
+        kernel = getattr(getattr(module, "quant_method", None), "moe_kernel", None)
+        impl = getattr(kernel, "fused_experts", None)
+        if isinstance(impl, Paired48Nvfp4ExpertsModular):
+            experts.append(impl)
+    return experts
+
+
+def _tune_capacity(
+    ex: Paired48Nvfp4ExpertsModular,
+    max_n: int,
+    tactics: list[tuple[int, int, int]],
+) -> tuple[tuple[int, int, int] | None, tuple[int, int, int] | None]:
+    """Tune (gemm1, gemm2) for one batched capacity ``max_n``.
+
+    Representative occupancy: every token slot occupied, routed uniformly
+    (counts = max_n * topk / E). Returns (None, None) (kernel default) on OOM.
+    """
+    k, n = ex.hidden_dim, ex.intermediate_dim
+    e_local = ex.num_experts
+    moe = ex.moe_config
+    cnt = min(max_n, max(1, math.ceil(max_n * moe.experts_per_token / moe.num_experts)))
+    counts = torch.full(
+        (e_local,), cnt, dtype=torch.int32, device=ex.w13_weight_comp.device
+    )
+    try:
+        t1 = _tune_one_gemm(
+            w_comp=ex.w13_weight_comp,
+            w_meta=ex.w13_weight_meta,
+            w_sf=ex.w13_weight_sf,
+            alphas=ex.g1_alphas,
+            gscale=ex.a1_gscale,
+            features=2 * n,
+            contraction=k,
+            max_n=max_n,
+            counts=counts,
+            tactics=tactics,
+            label=f"gemm1[E={e_local},max_n={max_n},N={2 * n},K={k}]",
+        )
+        t2 = _tune_one_gemm(
+            w_comp=ex.w2_weight_comp,
+            w_meta=ex.w2_weight_meta,
+            w_sf=ex.w2_weight_sf,
+            alphas=ex.g2_alphas,
+            gscale=ex.a2_gscale,
+            features=k,
+            contraction=n,
+            max_n=max_n,
+            counts=counts,
+            tactics=tactics,
+            label=f"gemm2[E={e_local},max_n={max_n},N={k},K={n}]",
+        )
+        return t1, t2
+    except torch.cuda.OutOfMemoryError:
+        logger.warning(
+            "paired_nvfp4 autotune: OOM allocating tuning buffers for "
+            "E=%d max_n=%d; keeping default tactics.",
+            e_local,
+            max_n,
+        )
+        return None, None
+    finally:
+        torch.cuda.empty_cache()
+
+
+def _tune_fused_gemm1(
+    ex: Paired48Nvfp4ExpertsModular,
+    max_n: int,
+    gemm1_tactic: tuple[int, int, int] | None,
+) -> tuple[int, int, int] | None:
+    """Fastest fused SwiGLU GEMM1 tactic at capacity ``max_n`` if it beats GEMM1 +
+    the separate activation (``gemm1_tactic``), else None.
+
+    Every candidate must reproduce the unfused bytes exactly and run at a small
+    capacity (decode CUDA graphs), like the plain tactics.
+    """
+    if not (ex.w13_interleaved and ops.paired_nvfp4_supports_fused_swiglu()):
+        return None
+    k, n, e = ex.hidden_dim, ex.intermediate_dim, ex.num_experts
+    moe = ex.moe_config
+    device = ex.w13_weight_comp.device
+    w13 = (ex.w13_weight_comp, ex.w13_weight_meta, ex.w13_weight_sf)
+
+    def operands(cap: int, cnt: int):
+        counts = torch.full((e,), cnt, dtype=torch.int32, device=device)
+        x = torch.randn(e, cap, k, dtype=torch.bfloat16, device=device)
+        a1, sf1 = ops.paired_nvfp4_quant_act(x, ex.a1_gscale, counts, 2 * n)
+        return counts, a1, sf1
+
+    try:
+        cnt = min(max_n, max(1, math.ceil(max_n * moe.experts_per_token / moe.num_experts)))
+        counts, a1, sf1 = operands(max_n, cnt)
+        c1 = torch.empty(e, max_n, 2 * n, dtype=torch.bfloat16, device=device)
+
+        def unfused():
+            ops.paired_nvfp4_moe_mm(
+                c1, *w13, a1, sf1, ex.g1_alphas, counts, 2 * n, k, tactic=gemm1_tactic
+            )
+            return ops.paired_nvfp4_silu_mul_quant_act(
+                c1, ex.a2_gscale, counts, k, interleaved=True, act=ex.gated_act
+            )
+
+        def fused(tactic, cnts=counts, a=a1, sf=sf1):
+            return ops.paired_nvfp4_group_mm_swiglu_quant(
+                *w13, a, sf, ex.g1_alphas, cnts, ex.a2_gscale, 2 * n, k, tactic,
+                act=ex.gated_act,
+            )
+
+        ref_b, ref_sf = unfused()
+        small = operands(8, 1)
+        screened = []
+        for cid, name in enumerate(ops.paired_nvfp4_group_mm_swiglu_configs()):
+            for cm, cn in _valid_clusters(name):
+                tactic = (cid, cm, cn)
+                try:
+                    b, sf = fused(tactic)
+                    fused(tactic, *small)
+                    torch.cuda.synchronize()
+                except Exception as exc:
+                    logger.debug("paired_nvfp4 fused %s: skip %s (%s)", name, tactic, exc)
+                    continue
+                same = torch.equal(sf, ref_sf) and torch.equal(b[:, :cnt], ref_b[:, :cnt])
+                if not same:
+                    logger.warning(
+                        "paired_nvfp4 fused GEMM1 tactic %s differs from the unfused "
+                        "path — rejected.",
+                        tactic,
+                    )
+                    continue
+                screened.append((_bench(lambda t=tactic: fused(t), _SCREEN_MS), tactic))
+        if not screened:
+            return None
+        best = min(screened)[1]
+        fused_ms = _bench(lambda: fused(best), _FINAL_MS)
+        unfused_ms = _bench(unfused, _FINAL_MS)
+        logger.info(
+            "paired_nvfp4 gemm1+swiglu[E=%d,max_n=%d]: fused %s %.1f us vs unfused "
+            "%.1f us -> %s",
+            e,
+            max_n,
+            best,
+            fused_ms * 1e3,
+            unfused_ms * 1e3,
+            "fused" if fused_ms < unfused_ms else "unfused",
+        )
+        return best if fused_ms < unfused_ms else None
+    except torch.cuda.OutOfMemoryError:
+        # Runs after the KV cache is allocated; large-capacity buffers for wide
+        # expert sets may not fit. Keep the unfused GEMM1 + activation path.
+        logger.warning(
+            "paired_nvfp4 autotune: OOM allocating fused GEMM1 tuning buffers for "
+            "E=%d max_n=%d; keeping the unfused path.",
+            e,
+            max_n,
+        )
+        return None
+    finally:
+        torch.cuda.empty_cache()
+
+
+def _capacity_buckets(small_max_n: int, max_n: int) -> list[int]:
+    """Capacities to tune: small_max_n, then powers of two up to max_n."""
+    if not 0 < small_max_n < max_n:
+        return [max_n]
+    caps = [small_max_n]
+    while caps[-1] * 2 < max_n:
+        caps.append(caps[-1] * 2)
+    return caps + [max_n]
+
+
+def paired_nvfp4_autotune(model: torch.nn.Module, small_max_n: int = 0) -> None:
+    """Tune group_mm tactics for every paired48_nvfp4 MoE layer in the model.
+
+    The runtime per-expert capacity is dynamic (``min(max_num_tokens, T)`` on
+    the capture-safe dispatch) and the fastest tile depends on it: 64-token
+    tiles win while experts see few tokens, larger ones at prefill sizes. So a
+    ladder of capacities is tuned per geometry, from ``small_max_n`` (the
+    largest CUDA-graph capture size; 0 tunes only the full capacity) doubling
+    up to the full ``max_n``. Results are deduped by geometry and frozen onto
+    the experts objects (see ``tactics_for``).
+    """
+    if not ops.paired_nvfp4_supports_tactics():
+        logger.info_once(
+            "paired_nvfp4 autotune skipped: installed kernel wheel has no "
+            "tactic support."
+        )
+        return
+
+    experts = paired48_experts(model)
+    if not experts:
+        return
+
+    tactics = _all_tactics()
+    cache: dict[tuple, list] = {}
+    for ex in experts:
+        if not hasattr(ex, "w13_weight_comp"):
+            logger.warning_once(
+                "paired_nvfp4 autotune: experts not compressed yet "
+                "(process_weights_after_loading did not run?); skipping."
+            )
+            continue
+        max_n = ex.tuning_capacity()
+        caps = _capacity_buckets(small_max_n, max_n)
+        key = (ex.num_experts, ex.intermediate_dim, ex.hidden_dim, tuple(caps))
+        key = key + (ex.w13_interleaved, ex.gated_act)
+        if key not in cache:
+            buckets = [(cap, _tune_capacity(ex, cap, tactics)) for cap in caps]
+            fused = [(cap, _tune_fused_gemm1(ex, cap, t[0])) for cap, t in buckets]
+            cache[key] = (buckets, fused)
+        buckets, fused = cache[key]
+        ex.set_tactic_buckets(buckets)
+        ex.fused_tactic_buckets = fused
