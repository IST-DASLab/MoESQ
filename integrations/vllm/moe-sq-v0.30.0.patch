index 0000000000..a217ba7afc
--- /dev/null
+++ b/tools/paired48_sparse_checkpoint.py
@@ -0,0 +1,233 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Convert a dense paired-4:8 NVFP4 (group_size=32) compressed-tensors MoE
+checkpoint to paired48 sparse storage, and back.
+
+Every per-expert ``*.experts.<e>.<proj>.weight_packed`` (dense packed NVFP4 with
+the pruned pairs stored as zero bytes) is replaced by ``weight_sparse_packed``
+[.., K/4] + ``weight_sparse_mask`` [.., K/16] (layout: see
+vllm/model_executor/layers/quantization/utils/paired48_sparse.py). Everything
+else, scales included, is copied byte-for-byte. The conversion is lossless and
+every converted tensor is round-trip checked before it is written.
+
+    python tools/paired48_sparse_checkpoint.py to-sparse SRC DST [--jobs N]
+    python tools/paired48_sparse_checkpoint.py to-dense  SRC DST [--jobs N]
+
+CPU only; one worker holds about 3x one input shard in RAM. The result loads with
+    --kernel-config '{"moe_backend":"paired48_nvfp4"}'
+exactly like the dense checkpoint.
+"""
+
+import argparse
+import importlib.util
+import json
+import multiprocessing
+import os
+import re
+import shutil
+import sys
+from concurrent.futures import ProcessPoolExecutor
+from pathlib import Path
+
+import torch
+from safetensors.torch import load, save_file
+
+
+def _load_helper():
+    # By file path, so the tool runs without an importable (compiled) vLLM.
+    path = (
+        Path(__file__).resolve().parents[1]
+        / "vllm/model_executor/layers/quantization/utils/paired48_sparse.py"
+    )
+    spec = importlib.util.spec_from_file_location("paired48_sparse", path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+p48 = _load_helper()
+
+INDEX = "model.safetensors.index.json"
+DENSE_SUFFIX = "weight_packed"
+EXPERT_RE = re.compile(
+    r"\.experts\.\d+\.[A-Za-z0-9_]+\."
+    r"(weight_packed|weight_sparse_packed|weight_sparse_mask)$"
+)
+
+
+def _quant_configs(cfg: dict) -> list[dict]:
+    """Every compressed-tensors quantization_config (top level and text_config)."""
+    found = []
+    for holder in (cfg, cfg.get("text_config") or {}):
+        qc = holder.get("quantization_config")
+        if isinstance(qc, dict) and qc.get("quant_method") == "compressed-tensors":
+            found.append(qc)
+    if not found:
+        raise SystemExit("no compressed-tensors quantization_config in config.json")
+    return found
+
+
+def _check_source_config(qcs: list[dict], to_sparse: bool) -> None:
+    for qc in qcs:
+        if qc.get("format") != "nvfp4-pack-quantized":
+            raise SystemExit(
+                f"expected format nvfp4-pack-quantized, got {qc.get('format')!r}"
+            )
+        for name, grp in (qc.get("config_groups") or {}).items():
+            w = grp.get("weights") or {}
+            fmt = (w.get("num_bits"), w.get("type"), w.get("group_size"))
+            if fmt != (4, "float", 32):
+                raise SystemExit(
+                    f"config group {name}: expected 4-bit float group_size=32 weights "
+                    f"(paired-4:8 NVFP4), got {w}"
+                )
+        has_marker = p48.is_enabled(qc)
+        if to_sparse and has_marker:
+            raise SystemExit("source is already paired48 sparse storage")
+        if not to_sparse and not has_marker:
+            raise SystemExit(
+                f"source has no {p48.CONFIG_KEY} marker; nothing to densify"
+            )
+
+
+def _convert_shard(src: str, dst: str, shard: str, to_sparse: bool) -> dict:
+    # One sequential read + in-memory parse instead of safe_open's mmap, which
+    # page-faults its way through the shard (slow on network filesystems).
+    with open(os.path.join(src, shard), "rb") as fh:
+        tensors = load(fh.read())
+    out: dict[str, torch.Tensor] = {}
+    n_conv = 0
+    for key, t in tensors.items():
+        m = EXPERT_RE.search(key)
+        if m is None:
+            out[key] = t
+            continue
+        suffix = m.group(1)
+        pre = key[: -len(suffix)]
+        if to_sparse and suffix == DENSE_SUFFIX:
+            values, mask = p48.compress_pair_bitmask(t)
+            rebuilt, _ = p48.decompress_pair_bitmask(values, mask, strict=True)
+            if not torch.equal(rebuilt, t):
+                raise RuntimeError(f"round trip mismatch on {key}")
+            out[pre + p48.PACKED_SUFFIX] = values
+            out[pre + p48.MASK_SUFFIX] = mask
+            n_conv += 1
+        elif not to_sparse and suffix == p48.PACKED_SUFFIX:
+            mask_key = pre + p48.MASK_SUFFIX
+            if mask_key not in tensors:
+                raise RuntimeError(f"{key}: mask {mask_key} not in the same shard")
+            dense, _ = p48.decompress_pair_bitmask(t, tensors[mask_key], strict=True)
+            out[pre + DENSE_SUFFIX] = dense
+            n_conv += 1
+        elif not to_sparse and suffix == p48.MASK_SUFFIX:
+            continue  # consumed with its values tensor
+        else:
+            raise RuntimeError(
+                f"unexpected {key} in a {'dense' if to_sparse else 'sparse'} source"
+            )
+    save_file(out, os.path.join(dst, shard), metadata={"format": "pt"})
+    return {
+        "shard": shard,
+        "keys": list(out),
+        "bytes": sum(t.numel() * t.element_size() for t in out.values()),
+        "converted": n_conv,
+    }
+
+
+def _copy_aux(src: Path, dst: Path) -> None:
+    for p in src.iterdir():
+        if p.name.endswith(".safetensors") or p.name in (INDEX, "config.json"):
+            continue
+        if p.is_dir():
+            shutil.copytree(p, dst / p.name)
+        else:
+            shutil.copy2(p, dst / p.name)
+
+
+def convert(src: str, dst: str, to_sparse: bool, jobs: int) -> None:
+    srcp, dstp = Path(src), Path(dst)
+    if dstp.exists() and any(dstp.iterdir()):
+        raise SystemExit(f"{dst} exists and is not empty")
+    with open(srcp / "config.json") as f:
+        cfg = json.load(f)
+    qcs = _quant_configs(cfg)
+    _check_source_config(qcs, to_sparse)
+    with open(srcp / INDEX) as f:
+        index = json.load(f)
+    shards = sorted(set(index["weight_map"].values()))
+    in_bytes = sum((srcp / s).stat().st_size for s in shards)
+
+    dstp.mkdir(parents=True, exist_ok=True)
+    results = []
+
+    def _done(r: dict) -> None:
+        results.append(r)
+        print(
+            f"[{len(results)}/{len(shards)}] {r['shard']}: {r['converted']} converted",
+            flush=True,
+        )
+
+    # Cap intra-op threads: these are small uint8 elementwise ops, and torch's
+    # default of one thread per core only adds contention on a busy host. Count
+    # the CPUs this process may run on (cpusets / Slurm / containers), not the
+    # host's, or `jobs` workers oversubscribe the allocation.
+    usable = len(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else None
+    threads = max(1, min(16, (usable or os.cpu_count() or 1) // max(1, jobs)))
+    if jobs <= 1:
+        torch.set_num_threads(threads)
+        for s in shards:
+            _done(_convert_shard(src, dst, s, to_sparse))
+    else:
+        # spawn, not fork: forked workers inherit torch's initialized OpenMP
+        # runtime and crawl at <1 core each.
+        with ProcessPoolExecutor(
+            max_workers=jobs,
+            mp_context=multiprocessing.get_context("spawn"),
+            initializer=torch.set_num_threads,
+            initargs=(threads,),
+        ) as ex:
+            futs = [ex.submit(_convert_shard, src, dst, s, to_sparse) for s in shards]
+            for fut in futs:
+                _done(fut.result())
+
+    weight_map = {k: r["shard"] for r in results for k in r["keys"]}
+    total = sum(r["bytes"] for r in results)
+    with open(dstp / INDEX, "w") as f:
+        json.dump(
+            {"metadata": {"total_size": total}, "weight_map": weight_map}, f, indent=2
+        )
+
+    for qc in qcs:
+        if to_sparse:
+            qc[p48.CONFIG_KEY] = p48.make_marker()
+        else:
+            qc.pop(p48.CONFIG_KEY, None)
+    with open(dstp / "config.json", "w") as f:
+        json.dump(cfg, f, indent=2)
+    _copy_aux(srcp, dstp)
+
+    out_bytes = sum((dstp / s).stat().st_size for s in shards)
+    n = sum(r["converted"] for r in results)
+    print(
+        f"{n} expert projections converted; shards {in_bytes / 2**30:.2f} GiB -> "
+        f"{out_bytes / 2**30:.2f} GiB ({out_bytes / in_bytes:.3f}x)"
+    )
+    if n == 0:
+        raise SystemExit("no expert weights matched; output would be identical")
+
+
+def main(argv=None) -> None:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("direction", choices=["to-sparse", "to-dense"])
+    ap.add_argument("src")
+    ap.add_argument("dst")
+    ap.add_argument("--jobs", type=int, default=1, help="shards converted in parallel")
+    args = ap.parse_args(argv)
+    convert(args.src, args.dst, args.direction == "to-sparse", args.jobs)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
