+def _maybe_enable_paired48_prequant_dispatch(
+    experts: mk.FusedMoEExperts,
+    prepare_finalize: mk.FusedMoEPrepareAndFinalize,
+) -> None:
+    """Let the all2all carry FP4 instead of bf16 for paired48 token-order
+    experts: the prepare/finalize quantizes rows once before dispatch
+    (quant_dtype "nvfp4_p48"). Exact only when every expert of the layer shares
+    one activation global scale, since the scale enters each block scale.
+    Enabled for FlashInfer's NVLink two-sided all2all; set
+    VLLM_PAIRED48_PREQUANT_DISPATCH=0 to keep bf16 dispatch."""
+    import dataclasses
+    import os
+
+    import vllm._custom_ops as ops
+    from vllm.model_executor.layers.fused_moe.experts.paired48_nvfp4_moe import (
+        Paired48Nvfp4ExpertsStandard,
+    )
+    from vllm.model_executor.layers.fused_moe.prepare_finalize.flashinfer_nvlink_two_sided import (  # noqa: E501
+        FlashInferNVLinkTwoSidedPrepareAndFinalize,
+    )
+
+    if not (
+        isinstance(experts, Paired48Nvfp4ExpertsStandard)
+        and isinstance(prepare_finalize, FlashInferNVLinkTwoSidedPrepareAndFinalize)
+        and os.environ.get("VLLM_PAIRED48_PREQUANT_DISPATCH", "1") != "0"
+        and ops.paired_nvfp4_supports_prequant_dispatch()
+    ):
+        return
+    qc = experts.quant_config
+    gs = qc.a1_gscale
+    if gs is None or not bool((gs == gs.reshape(-1)[0]).all()):
+        logger.info_once(
+            "paired48_nvfp4: per-expert activation scales differ; keeping bf16 "
+            "all2all dispatch."
+        )
+        return
+    experts.quant_config = dataclasses.replace(
+        qc, _a1=dataclasses.replace(qc._a1, dtype="nvfp4_p48")
+    )
+    experts.prequantized_input = True
+    logger.info_once("paired48_nvfp4: FP4 all2all dispatch enabled.")
+
