+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Numeric check for the paired-4:8 NVFP4 (W4A4) MoE kernel.
+
+Mirrors ``test_nvfp4_moe.py`` but (a) prunes the expert weights to paired-4:8
+*before* quantization — so the sparse kernel and the dequantize-then-dense
+reference see the same pruned weight — and (b) drives
+``Paired48Nvfp4ExpertsModular`` (which compresses the weight via
+``paired_nvfp4_compress`` and runs ``paired_nvfp4_group_mm``).
+
+Checks the SFA/SFB scale-factor layouts and per-expert alphas against a
+dequantize-then-dense reference.
+
+Skips unless running on SM100/SM120 with the paired_nvfp4_kernels ops installed.
+"""
+
+import pytest
+import torch
+
+import vllm.model_executor.layers.fused_moe.modular_kernel as mk
+from tests.kernels.moe.utils import make_dummy_moe_config
+from tests.kernels.quantization.nvfp4_utils import get_nvfp4_global_scale
+from vllm import _custom_ops as ops
+from vllm.config import ParallelConfig, VllmConfig, set_current_vllm_config
+from vllm.model_executor.layers.fused_moe import fused_topk
+from vllm.model_executor.layers.fused_moe.config import nvfp4_moe_quant_config
+from vllm.model_executor.layers.fused_moe.experts.paired48_nvfp4_moe import (
+    Paired48Nvfp4ExpertsModular,
+)
+from vllm.model_executor.layers.fused_moe.prepare_finalize.batched import (
+    BatchedPrepareAndFinalize,
+)
+from vllm.model_executor.layers.quantization.utils.nvfp4_emulation_utils import (
+    cast_to_fp4,
+    ref_nvfp4_quant,
+)
+from vllm.platforms import current_platform
+from vllm.utils.torch_utils import set_random_seed
+
+if not current_platform.has_device_capability(100):
+    pytest.skip(
+        "paired-4:8 NVFP4 requires compute capability 10.0+",
+        allow_module_level=True,
+    )
+
+# The external kernel extension registers torch.ops.paired_nvfp4.* on import;
+# skip cleanly until it is installed so this file is safe to land before it.
+if not ops.paired_nvfp4_available():
+    pytest.skip(
+        "paired_nvfp4_kernels extension not installed",
+        allow_module_level=True,
+    )
+
+SF_BLOCK = 32  # sparse NVFP4 MMA SFVecSize: per-32 scales for BOTH operands
+
+# e2m1 magnitudes for the 3-bit code 0..7 (sign is the 4th bit). Matches the
+# decode table in ``break_fp4_bytes``.
+_E2M1_MAGS = [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0]
+
+
+def _pack_fp4(vals: torch.Tensor) -> torch.Tensor:
+    """Encode e2m1 fp4 *values* ``[..., K]`` to packed uint8 ``[..., K/2]``.
+
+    Inverse of ``break_fp4_bytes``: a byte holds ``low(elem 2j) | high(elem
+    2j+1) << 4``; each nibble is ``sign << 3 | magnitude_code`` where the code
+    indexes ``_E2M1_MAGS``. ``vals`` must already sit on the e2m1 grid (the
+    output of ``ref_nvfp4_quant``), so the magnitude match is exact.
+    """
+    mags = torch.tensor(_E2M1_MAGS, device=vals.device)
+    code = (vals.abs().unsqueeze(-1) == mags).to(torch.uint8).argmax(-1)
+    nib = ((vals < 0).to(torch.uint8) * 8) | code  # [..., K] in 0..15
+    low, high = nib[..., 0::2], nib[..., 1::2]
+    return (low | (high << 4)).to(torch.uint8)
+
+
+def prune_paired_4_8(w: torch.Tensor) -> torch.Tensor:
+    """Zero 2 of every 4 fp4 *pairs* along K (keep the 2 largest-mag-sum pairs).
+
+    K (the last dim here) is the contraction dim = the sparse axis of the weight
+    (operand A). The SM100 fp4 sparse format is PAIR-granular: one sparsity
+    element is an ``nv_float4_t`` pair (2 adjacent fp4 along K), and each
+    8-element chunk keeps 2 of its 4 pairs. An element-wise 4-of-8 prune
+    produces kept-patterns the 4:8 metadata cannot encode, and ``compress()``
+    then silently reads garbage. Mirrors
+    ``paired_nvfp4_kernels.reference.prune_paired_4of8``.
+    """
+    *lead, k = w.shape
+    assert k % 8 == 0, "K must be a multiple of 8 for paired-4:8"
+    g = w.reshape(*lead, k // 8, 4, 2)
+    keep = g.abs().sum(-1).topk(2, dim=-1).indices  # [..., k//8, 2] pair ids
+    mask = torch.zeros(g.shape[:-1], dtype=torch.bool, device=w.device)
+    mask.scatter_(-1, keep, True)
+    return (g * mask.unsqueeze(-1)).reshape(*lead, k)
+
+
+def _quantize_experts_gs32(w: torch.Tensor):
+    """Per-expert NVFP4 weight quant at group_size=32 (the sparse-MMA SFVecSize).
+
+    ``w``: ``[E, out, K]`` (already paired-4:8-pruned along K). The kernel's
+    ``paired_nvfp4_compress`` wants packed fp4 + LINEAR per-32 fp8 block scales
+    ``[E, out, K/32]`` and applies ``alpha = 1/gscale`` in the epilogue. Returns
+    ``(packed[E,out,K/2] uint8, blockscale[E,out,K/32] fp8, gscale[E] f32,
+    w_deq[E,out,K] f32)`` where ``w_deq = fp4 * blockscale / gscale`` is exactly
+    the dense weight the kernel reconstructs. ``w_deq`` is kept in FLOAT32: the
+    kernel's fp4*sf products are exact and accumulated in fp32, so rounding the
+    reference weight to bf16 would inject ~0.4%/element noise that quantization
+    boundaries downstream amplify chaotically.
+    """
+    e = w.shape[0]
+    packed, bscale, gs, deq = [], [], [], []
+    for i in range(e):
+        g = get_nvfp4_global_scale(w[i])  # scalar f32
+        fp4_vals, scale = ref_nvfp4_quant(w[i], g, SF_BLOCK)  # f32 grid, fp8 sf
+        packed.append(_pack_fp4(fp4_vals))
+        bscale.append(scale.to(torch.float8_e4m3fn))
+        gs.append(g)
+        scale_exp = scale.repeat_interleave(SF_BLOCK, dim=-1)
+        deq.append(fp4_vals * scale_exp / g)  # float32
+    return (
+        torch.stack(packed),
+        torch.stack(bscale),
+        torch.stack(gs).reshape(e),
+        torch.stack(deq),
+    )
+
+
+def _ref_quant_act_gs32(x: torch.Tensor, gscale: float = 1.0) -> torch.Tensor:
+    """Quant-dequant emulation of the kernel's ``quant_act`` op (SFVecSize=32).
+
+    Mirrors ``quant_act_kernel`` exactly: per 32-element K block ``bsf = amax/6``
+    (1.0 for an all-zero block), stored scale ``s = ue4m3(bsf * gscale)``, and
+    the fp4 codes quantized against the DEQUANTIZED stored scale (FlashInfer
+    convention): ``e2m1(x * gscale / f32(s))``. The dequant the GEMM sees is
+    then ``fp4 * f32(s) / gscale`` with a pure-e2m1 residual (no ue4m3 scale
+    rounding bias). ``test_paired48_nvfp4_quant_act_matches_emulation`` pins
+    this emulation against the real op byte-for-byte.
+    """
+    m, k = x.shape
+    xb = x.float().reshape(m, k // SF_BLOCK, SF_BLOCK)
+    amax = xb.abs().amax(dim=-1, keepdim=True)
+    bsf = torch.where(amax > 0, amax / 6.0, torch.ones_like(amax))
+    sf = (bsf * gscale).to(torch.float8_e4m3fn).to(torch.float32)
+    inv = torch.where(sf > 0, gscale / sf, torch.zeros_like(sf))
+    fp4 = cast_to_fp4(xb * inv)
+    return (fp4 * sf / gscale).reshape(m, k).to(x.dtype)
+
+
+@pytest.mark.parametrize("m,n,k", [(64, 1024, 1024), (224, 1024, 1536)])
+@pytest.mark.parametrize("e", [8, 64])
+@pytest.mark.parametrize("topk", [1, 6])
+@torch.inference_mode()
+def test_paired48_nvfp4_moe_numerics(
+    m: int, n: int, k: int, e: int, topk: int, workspace_init
+):
+    set_random_seed(7)
+    dtype = torch.bfloat16
+    with set_current_vllm_config(
+        VllmConfig(parallel_config=ParallelConfig(pipeline_parallel_size=1))
+    ):
+        # O(1) activations (weights stay /10): keeps the outputs large enough
+        # that rtol — not the atol floor — does the work in assert_close, and
+        # keeps the GEMM2-side block scales out of the e4m3 subnormal range.
+        a = torch.randn((m, k), device="cuda", dtype=dtype)
+
+        # Paired-4:8-pruned NVFP4 expert weights (prune BEFORE quant so the
+        # dense reference uses the same pruned weight as the sparse kernel).
+        w1 = prune_paired_4_8(
+            torch.randn((e, 2 * n, k), device="cuda", dtype=dtype) / 10
+        )
+        w2 = prune_paired_4_8(torch.randn((e, k, n), device="cuda", dtype=dtype) / 10)
+        # gs=32 weight quant; w1_d/w2_d are the kernel-equivalent dense weights
+        # used by the dequantize-then-dense reference below.
+        w1_q, w1_blockscale, w1_gs, w1_d = _quantize_experts_gs32(w1)
+        w2_q, w2_blockscale, w2_gs, w2_d = _quantize_experts_gs32(w2)
+
+        score = torch.randn((m, e), device="cuda", dtype=dtype)
+        topk_weights, topk_ids, _ = fused_topk(a, score, topk, renormalize=False)
+        # Batched capacity: must hold the busiest expert's token count, padded to
+        # a multiple of 128 (the sparse kernel's CTA-N token tile granularity).
+        max_cnt = int(torch.bincount(topk_ids.flatten(), minlength=e).max().item())
+        max_num_tokens = max(128, ((max_cnt + 127) // 128) * 128)
+        a1_gs = torch.ones((e,), device="cuda", dtype=torch.float32)
+        a2_gs = torch.ones((e,), device="cuda", dtype=torch.float32)
+
+        quant_config = nvfp4_moe_quant_config(
+            g1_alphas=(1 / w1_gs),
+            g2_alphas=(1 / w2_gs),
+            a1_gscale=a1_gs,
+            a2_gscale=a2_gs,
+            w1_scale=w1_blockscale,
+            w2_scale=w2_blockscale,
+        )
+        moe_config = make_dummy_moe_config()
+        experts = Paired48Nvfp4ExpertsModular(
+            moe_config=moe_config,
+            quant_config=quant_config,
+            max_num_tokens=max_num_tokens,
+            num_dispatchers=1,
+        )
+        # Mirror process_weights_after_loading: compress the dense packed weights
+        # into the sparse A operand + metadata + SFA-layout scales. (input_scale
+        # is 1 here, so the scale_2 fusion is the identity and is skipped.)
+        (
+            experts.w13_weight_comp,
+            experts.w13_weight_meta,
+            experts.w13_weight_sf,
+        ) = ops.paired_nvfp4_compress(w1_q, w1_blockscale, k)
+        (
+            experts.w2_weight_comp,
+            experts.w2_weight_meta,
+            experts.w2_weight_sf,
+        ) = ops.paired_nvfp4_compress(w2_q, w2_blockscale, n)
+
+        kernel = mk.FusedMoEKernel(
+            BatchedPrepareAndFinalize(
+                max_num_tokens=max_num_tokens,
+                num_local_experts=e,
+                num_dispatchers=1,
+                rank=0,
+            ),
+            experts,
+        )
+        out = kernel.apply(
+            hidden_states=a,
+            w1=w1_q,
+            w2=w2_q,
+            topk_weights=topk_weights,
+            topk_ids=topk_ids,
+            global_num_experts=e,
+            activation=mk.MoEActivation.SILU,
+            apply_router_weight_on_input=False,
+            expert_map=None,
+        )
+
+        # Dequantize-then-dense reference with BOTH activation quants emulated
+        # bit-exactly (kernel quant_act math, gs=32, gscale=1): the GEMM1 input
+        # quant of `a` and the GEMM2 input quant of the SiLU+mul intermediate.
+        # Precision discipline — every channel is matched to the kernel path so
+        # the residual is fp32 accumulation ORDER only: a_deq is exact in bf16
+        # (fp4*ue4m3 products have <= 6 significand bits), the weights stay
+        # FLOAT32 (the kernel's fp4*sf products are exact, fp32-accumulated),
+        # GEMMs run in fp32 and round to bf16 exactly where the kernel writes
+        # bf16 (the GEMM1 output / GEMM2 input), SiLU+mul uses the *same* CUDA
+        # op as the driver, and the topk reduce mirrors the eager finalize's
+        # TopKWeightAndReduceNaiveBatched bit-for-bit: per-expert IN ORDER,
+        # the router weight applied as ONE bf16 rounding, then a bf16 += per
+        # expert step. (Summing in fp32 instead leaves ~1-ulp-of-the-largest-
+        # term differences that fail a tight per-element tolerance at topk>1;
+        # topk=1 has no accumulation and was unaffected.) The fused_topk
+        # weights/ids are reused directly (renormalize=False) so topk
+        # tie-breaks cannot diverge. This is what lets the tolerance below be
+        # ~5x tighter than the dense-ref 1e-1.
+        a_deq = _ref_quant_act_gs32(a)
+        ref = torch.zeros(m, k, device=a.device, dtype=dtype)
+        contrib_max = torch.zeros(m, k, device=a.device, dtype=torch.float32)
+        for i in range(e):
+            matched = topk_ids == i  # [m, topk]; <= 1 True per row
+            toks = matched.any(dim=1)
+            if not bool(toks.any()):
+                continue
+            c1 = (a_deq[toks].float() @ w1_d[i].t()).to(dtype)
+            inter = torch.empty((c1.shape[0], n), device=a.device, dtype=dtype)
+            torch.ops._C.silu_and_mul(inter, c1)
+            o = (_ref_quant_act_gs32(inter).float() @ w2_d[i].t()).to(dtype)
+            o = (o * topk_weights[matched].view(-1, 1)).to(dtype)
+            ref[toks] = ref[toks] + o
+            # Largest weighted contribution per element — sets the floor of the
+            # reduce's bf16 rounding error (see the tolerance below).
+            contrib_max[toks] = torch.maximum(contrib_max[toks], o.abs().float())
+
+        nan_out = int(torch.isnan(out).sum())
+        assert nan_out == 0, "kernel output contains NaN"
+        # Global gate: catches systematic errors (scale/alpha/layout) at the
+        # bf16 noise floor regardless of the per-element allowance below.
+        rel_rms_all = float(
+            (out.float() - ref.float()).norm() / ref.float().norm().clamp_min(1e-12)
+        )
+        assert rel_rms_all < 5e-3, f"rel-RMS {rel_rms_all:.4f} >= 5e-3"
+        # Per-element gate: atol/rtol plus a reduce-rounding allowance. Even
+        # with the bit-mirrored reduce, fp32 GEMM accumulation-order noise can
+        # flip a bf16 rounding in one term; the resulting error is a few ulps
+        # of the largest weighted CONTRIBUTION to that element — which dwarfs
+        # any fixed atol on cancellation-heavy elements (large +- terms, small
+        # sum). 2**-8 = one bf16 ulp (relative).
+        diff = (out.float() - ref.float()).abs()
+        allow = 2e-2 + 5e-2 * ref.float().abs() + 4 * (2.0**-8) * contrib_max
+        bad = diff > allow
+        assert not bool(bad.any()), (
+            f"{int(bad.sum())}/{out.numel()} elements exceed tolerance; "
+            f"max excess {float((diff - allow).max()):.4f}; "
+            f"max abs diff {float(diff.max()):.4f}"
+        )
+
+
+@torch.inference_mode()
+def test_paired48_nvfp4_quant_act_matches_emulation(workspace_init):
+    """Byte-tight A/B of the real ``quant_act`` op against ``_ref_quant_act_gs32``.
+
+    Reads the op's ``(b_act, sfb)`` back exactly as ``group_mm`` reads them (via
+    the wheel's ``probe_act_layout`` test op) and compares with the Python
+    emulation the main numerics test's reference is built on. A mismatch here
+    means the quant convention drifted between the wheel and the emulation
+    (e.g. rounded- vs unrounded-scale divisor — a per-block multiplicative
+    discrepancy of up to half an e4m3 ulp, which surfaces in the main test as a
+    flat ~3.7% rel-RMS across all shapes). Skips unless the wheel was built
+    with PAIRED_NVFP4_BUILD_TESTS=1.
+    """
+    if not hasattr(torch.ops, "_paired_nvfp4_test") or not hasattr(
+        torch.ops._paired_nvfp4_test, "probe_act_layout"
+    ):
+        pytest.skip("wheel built without PAIRED_NVFP4_BUILD_TESTS=1 (no probe op)")
+    set_random_seed(11)
+    e, max_n, k, features = 4, 128, 1024, 512
+    x = torch.randn((e, max_n, k), device="cuda", dtype=torch.bfloat16)
+    gscale = torch.ones((e,), device="cuda", dtype=torch.float32)
+    counts = torch.full((e,), max_n, device="cuda", dtype=torch.int32)
+    counts[-1] = max_n // 2  # exercise the padded-row branch too
+
+    b_act, sfb = torch.ops.paired_nvfp4.quant_act(x, gscale, counts, features)
+    recon = torch.ops._paired_nvfp4_test.probe_act_layout(
+        b_act.contiguous(),
+        sfb.contiguous().view(torch.uint8),
+        features,
+        max_n,
+        k,
+        e,
+    ).to(device=x.device, dtype=torch.float32)
+
+    ref = torch.stack([_ref_quant_act_gs32(x[i]).float() for i in range(e)])
+    for i in range(e):
+        c = int(counts[i])
+        r, want = recon[i, :c], ref[i, :c]
+        max_rel = float(((r - want).abs() / want.abs().clamp_min(1e-6)).max())
+        assert max_rel < 1e-5, (
+            f"expert {i}: quant_act vs emulation max_rel {max_rel:.6f} — the "
+            "op's quant convention no longer matches _ref_quant_act_gs32 "
+            "(sf = ue4m3(amax/6 * g), fp4 = e2m1(x*g/f32(sf))); realign one "
+            "side, then fix the main test's reference accordingly."
+        )
+        # Padded rows: b_act is UNDEFINED -- the op skips their store entirely, and
+        # group_mm clips every expert to counts[e] so those bytes are never read.
+        # What DOES still hold, and is the invariant worth guarding, is that their
+        # SF slots carry a benign NONZERO scale, so a dequant through the cute
+        # layouts stays finite -- the shared SF tile must never see a 0/0.
+        if c < max_n:
+            assert bool(torch.isfinite(recon[i, c:]).all()), (
+                f"expert {i}: padded rows dequant to non-finite values — the benign "
+                "SF fill on rows past expert_num_tokens[e] is broken (0/0 in the "
+                "shared SF tile)"
+            )
+
+
+@torch.inference_mode()
+def test_paired48_nvfp4_fused_silu_quant_bit_identical(workspace_init):
+    """The fused ``silu_mul_quant_act`` op must be BYTE-IDENTICAL to the unfused
+    chain ``torch.ops._C.silu_and_mul -> paired_nvfp4.quant_act`` it replaces.
+
+    The fused kernel replicates vLLM's exact silu rounding chain (silu computed
+    in fp32, rounded to bf16, then a bf16 multiply) and the identical quant
+    tail, so this is an exact-equality assertion, not allclose: any byte diff
+    is a real regression in the fused path (or a silu rounding change in
+    vLLM's _C kernel that the wheel must mirror). Skips if the installed wheel
+    lacks the fused op.
+    """
+    if not ops.paired_nvfp4_supports_fused_silu_quant():
+        pytest.skip("installed paired_nvfp4_kernels lacks silu_mul_quant_act")
+    set_random_seed(13)
+    # n = intermediate width (GEMM2's K), features = GEMM2's M (= layer hidden k).
+    e, max_n, n, features = 4, 192, 512, 1024
+    c1 = torch.randn((e, max_n, 2 * n), device="cuda", dtype=torch.bfloat16)
+    gscale = 0.5 + 0.25 * torch.arange(e, device="cuda", dtype=torch.float32)
+    counts = torch.full((e,), max_n, device="cuda", dtype=torch.int32)
+    counts[1] = max_n // 2  # exercise padded rows
+    counts[2] = 1
+
+    # Unfused reference chain (the unfused fallback path).
+    a2 = torch.empty((e, max_n, n), device="cuda", dtype=torch.bfloat16)
+    torch.ops._C.silu_and_mul(a2, c1)
+    b_ref, sfb_ref = torch.ops.paired_nvfp4.quant_act(a2, gscale, counts, features)
+
+    # Fused op under test.
+    b_fus, sfb_fus = ops.paired_nvfp4_silu_mul_quant_act(c1, gscale, counts, features)
+
+    assert b_fus.shape == b_ref.shape and sfb_fus.shape == sfb_ref.shape
+    # b_act: VALID rows only. Both ops skip the store on rows past
+    # expert_num_tokens[e] (never read — group_mm clips to counts[e]), so their
+    # padding is unrelated allocator garbage on each side by design. sfb below stays
+    # a full-buffer comparison: every in-range SF slot is still written by both, and
+    # that is what makes skipping the b_act padding safe.
+    for i in range(e):
+        c = int(counts[i])
+        bf_i, br_i = b_fus[i, :c], b_ref[i, :c]
+        assert torch.equal(bf_i, br_i), (
+            f"expert {i}: b_act differs in {int((bf_i != br_i).sum())}/{br_i.numel()} "
+            "bytes on valid rows — fused silu+quant is not bit-identical to "
+            "silu_and_mul -> quant_act"
+        )
+    assert torch.equal(sfb_fus, sfb_ref), (
+        f"sfb differs in {int((sfb_fus != sfb_ref).sum())}/{sfb_ref.numel()} bytes — "
+        "fused silu+quant SF path diverged from the unfused chain"
+    )
+
+
+@torch.inference_mode()
+def test_paired48_nvfp4_fused_scatter_quant_bit_identical(workspace_init):
+    """The fused ``scatter_quant_act`` op must match the unfused dispatch chain
+    (``index_select -> index_copy_ -> quant_act``) BYTE-FOR-BYTE on valid rows,
+    driving the REAL ``CaptureSafeBatchedPrepareAndFinalize._dispatch_plan``
+    (including capacity-overflow -> trash-row routings).
+
+    b_act is compared directly per expert over its first ``counts[e]`` rows.
+    The SF path is compared via the wheel's ``probe_act_layout`` (dequantizes
+    (b_act, sfb) through the exact cute layouts group_mm reads): with b_act
+    bytes already equal, recon equality on valid rows pins the SFB slots too —
+    and since the reference quant_act ran with a REAL ``features`` while the
+    fused op uses an internal placeholder, equality also re-proves the SFB
+    layout's M-independence at this level. Skips if the installed wheel lacks
+    the fused op.
+    """
+    if not ops.paired_nvfp4_supports_scatter_quant():
+        pytest.skip("installed paired_nvfp4_kernels lacks scatter_quant_act")
+    if not hasattr(torch.ops, "_paired_nvfp4_test") or not hasattr(
+        torch.ops._paired_nvfp4_test, "probe_act_layout"
+    ):
+        pytest.skip("wheel built without PAIRED_NVFP4_BUILD_TESTS=1 (no probe op)")
+    from vllm.model_executor.layers.fused_moe.prepare_finalize.batched_capture_safe import (  # noqa: E501
+        CaptureSafeBatchedPrepareAndFinalize,
+    )
+
+    set_random_seed(17)
+    # cap = min(max_num_tokens, T) = 48 < mean per-expert load region -> exercises
+    # overflow->trash; distinct experts per token like a real router.
+    t, topk, k, e, features = 128, 8, 1024, 16, 768
+    pf = CaptureSafeBatchedPrepareAndFinalize(
+        max_num_tokens=48, num_local_experts=e, num_dispatchers=1, rank=0
+    )
+    a1 = torch.randn(t, k, device="cuda", dtype=torch.bfloat16)
+    topk_ids = torch.stack(
+        [torch.randperm(e, device="cuda")[:topk] for _ in range(t)]
+    ).to(torch.int64)
+    flat_tok, dest_global, _, counts, n_routed, cap = pf._dispatch_plan(topk_ids)
+    gscale = 0.5 + 0.25 * torch.arange(e, device="cuda", dtype=torch.float32)
+
+    # Unfused reference chain (the unfused fallback path).
+    src = a1.index_select(0, flat_tok)
+    b_ext = torch.empty(e * cap + 1, k, dtype=a1.dtype, device=a1.device)
+    b_ext.index_copy_(0, dest_global, src)
+    b_ref_bf16 = b_ext[: e * cap].view(e, cap, k)
+    bq_ref, sf_ref = torch.ops.paired_nvfp4.quant_act(
+        b_ref_bf16, gscale, counts, features
+    )
+
+    # Fused op under test (no router weights — the default Qwen-style path).
+    bq_fus, sf_fus = ops.paired_nvfp4_scatter_quant_act(
+        a1, flat_tok, dest_global, None, gscale, counts, cap
+    )
+    assert bq_fus.shape == bq_ref.shape
+
+    counts_cpu = counts.cpu()
+    for i in range(e):
+        c = int(counts_cpu[i])
+        assert torch.equal(bq_fus[i, :c], bq_ref[i, :c]), (
+            f"expert {i}: fused scatter+quant b_act differs from the unfused "
+            f"chain on valid rows"
+        )
+
+    # SF check via dequant-through-the-kernel-layouts (valid rows only; padded
+    # rows deviate by design: garbage b_act / benign SF fill, never read).
+    recon_ref = torch.ops._paired_nvfp4_test.probe_act_layout(
+        bq_ref.contiguous(), sf_ref.contiguous().view(torch.uint8), features, cap, k, e
+    )
+    recon_fus = torch.ops._paired_nvfp4_test.probe_act_layout(
+        bq_fus.contiguous(), sf_fus.contiguous().view(torch.uint8), features, cap, k, e
+    )
+    for i in range(e):
+        c = int(counts_cpu[i])
+        assert torch.equal(recon_fus[i, :c], recon_ref[i, :c]), (
+            f"expert {i}: fused scatter+quant SFB slots diverge from the "
+            f"unfused chain on valid rows"
+        )
