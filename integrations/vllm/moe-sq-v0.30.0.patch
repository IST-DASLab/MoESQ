@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests for the paired-4:8 NVFP4 ``pair-bitmask`` checkpoint storage."""
+
+import pytest
+import torch
+
+from vllm.model_executor.layers.quantization.utils import paired48_sparse as p48
+
+
+def _random_paired48(shape: tuple[int, ...], seed: int = 0) -> torch.Tensor:
+    """Dense packed NVFP4 bytes with exactly 2 nonzero bytes per 4-byte chunk."""
+    *lead, kb = shape
+    g = torch.Generator().manual_seed(seed)
+    vals = torch.randint(1, 256, (*lead, kb // 4, 4), generator=g, dtype=torch.uint8)
+    keep = torch.rand(*lead, kb // 4, 4, generator=g).argsort(-1)[..., :2]
+    mask = torch.zeros(vals.shape, dtype=torch.bool).scatter_(-1, keep, True)
+    return (vals * mask).reshape(shape)
+
+
+@pytest.mark.parametrize("shape", [(64, 256), (3, 48, 128), (5, 2, 64, 16)])
+def test_round_trip(shape):
+    dense = _random_paired48(shape)
+    values, mask = p48.compress_pair_bitmask(dense)
+    assert values.shape == (*shape[:-1], shape[-1] // 2)
+    assert mask.shape == (*shape[:-1], shape[-1] // 8)
+    rebuilt, n_invalid = p48.decompress_pair_bitmask(values, mask, experts_per_slice=2)
+    assert n_invalid == 0
+    assert torch.equal(rebuilt, dense)
+
+
+def test_chunks_with_fewer_than_two_nonzero_bytes():
+    # Kept pairs that quantized to zero: real checkpoints have ~0.1% of these.
+    dense = _random_paired48((4, 64))
+    dense[0, :8] = 0
+    dense[1, :4] = torch.tensor([0, 0, 7, 0], dtype=torch.uint8)
+    values, mask = p48.compress_pair_bitmask(dense)
+    # Top-up marks the lowest zero bytes: chunk [0,0,7,0] keeps bytes 0 and 2.
+    assert int(mask[1, 0]) & 0xF == 0b0101
+    rebuilt, _ = p48.decompress_pair_bitmask(values, mask)
+    assert torch.equal(rebuilt, dense)
+
+
+def test_rejects_non_paired48():
+    dense = _random_paired48((2, 64))
+    dense[0, :4] = torch.tensor([1, 2, 3, 0], dtype=torch.uint8)
+    with pytest.raises(ValueError, match="not paired-4:8"):
+        p48.compress_pair_bitmask(dense)
+
+
+def test_rejects_k_not_multiple_of_16():
+    with pytest.raises(ValueError, match="K % 16"):
+        p48.compress_pair_bitmask(torch.zeros(2, 12, dtype=torch.uint8))
+
+
+def test_invalid_mask_strict_and_lenient():
+    values, mask = p48.compress_pair_bitmask(_random_paired48((2, 64)))
+    mask[0, 0] = 0xFF  # both nibbles have 4 bits set
+    with pytest.raises(ValueError, match="invalid mask nibble"):
+        p48.decompress_pair_bitmask(values, mask)
+    rebuilt, n_invalid = p48.decompress_pair_bitmask(values, mask, strict=False)
+    assert n_invalid == 2
+    assert rebuilt.shape == (2, 64)
+
+
+def test_config_marker():
+    assert not p48.is_enabled(None)
+    assert not p48.is_enabled({"format": "nvfp4-pack-quantized"})
+    assert p48.is_enabled({p48.CONFIG_KEY: p48.make_marker()})
+    with pytest.raises(ValueError, match="unsupported"):
+        p48.is_enabled({p48.CONFIG_KEY: {"layout": "pair-bitmask", "version": 2}})
