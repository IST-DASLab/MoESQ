+++ b/tests/kernels/moe/test_paired48_nvfp4_selection.py
@@ -0,0 +1,173 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Selection-path tests for the paired-4:8 NVFP4 (W4A4) MoE backend.
+
+These run without a GPU: they exercise only the oracle wiring + the static
+selection contract of ``Paired48Nvfp4ExpertsModular`` (no kernel launch).
+"""
+
+from types import SimpleNamespace
+
+import pytest
+
+import vllm.model_executor.layers.fused_moe.modular_kernel as mk
+from vllm.config.kernel import MoEBackend
+from vllm.model_executor.layers.fused_moe.experts.paired48_nvfp4_moe import (
+    Paired48Nvfp4ExpertsModular,
+    Paired48Nvfp4ExpertsStandard,
+)
+from vllm.model_executor.layers.fused_moe.oracle.nvfp4 import (
+    NvFp4MoeBackend,
+    backend_to_kernel_cls,
+    map_nvfp4_backend,
+)
+from vllm.model_executor.layers.quantization.utils.quant_utils import (
+    kNvfp4Dynamic,
+    kNvfp4Static,
+)
+
+
+def test_string_maps_to_enum():
+    assert map_nvfp4_backend("paired48_nvfp4") == NvFp4MoeBackend.PAIRED48_NVFP4
+
+
+def test_backend_string_is_a_valid_moe_backend():
+    assert "paired48_nvfp4" in MoEBackend.__args__
+
+
+def test_enum_returns_standard_then_batched_experts():
+    assert backend_to_kernel_cls(NvFp4MoeBackend.PAIRED48_NVFP4) == [
+        Paired48Nvfp4ExpertsStandard,
+        Paired48Nvfp4ExpertsModular,
+    ]
+
+
+def test_is_modular_not_monolithic():
+    assert issubclass(Paired48Nvfp4ExpertsModular, mk.FusedMoEExpertsModular)
+    assert not issubclass(Paired48Nvfp4ExpertsModular, mk.FusedMoEExpertsMonolithic)
+
+
+def test_static_selection_contract():
+    c = Paired48Nvfp4ExpertsModular
+    # The GEMM itself is batched-only (it slices each expert's operands at a
+    # fixed max_n stride); this class consumes the batched layout directly.
+    # Paired48Nvfp4ExpertsStandard builds that layout from token order.
+    assert c.activation_format() == mk.FusedMoEActivationFormat.BatchedExperts
+    assert c._supports_quant_scheme(kNvfp4Static, kNvfp4Dynamic)
+    assert not c._supports_quant_scheme(kNvfp4Static, None)
+    # EP-aware: must NOT be gated to ep_size == 1.
+    assert c._supports_parallel_config(SimpleNamespace(ep_size=4))
+
+
+# ---- compressed-tensors group_size=32 wiring (GPU-free) ----------------------
+#
+# llm-compressor emits W4A4 NVFP4 checkpoints with `quant_method:
+# compressed-tensors` and (for the paired-4:8 sparse pipeline) group_size=32.
+# Detection must accept gs=32 ONLY via the explicit group_size parameter (so
+# nothing dense ever sees it), and the MoE method must fail closed unless the
+# paired48 backend is selected.
+
+
+def _nvfp4_args(group_size: int):
+    from compressed_tensors.quantization import QuantizationArgs
+
+    return QuantizationArgs(
+        num_bits=4,
+        type="float",
+        strategy="tensor_group",
+        group_size=group_size,
+        symmetric=True,
+    )
+
+
+def test_ct_nvfp4_detection_group_sizes():
+    from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors import (  # noqa: E501
+        CompressedTensorsConfig,
+    )
+
+    is_nvfp4 = CompressedTensorsConfig._is_nvfp4_format
+    # gs=16 (standard NVFP4): unchanged behavior.
+    assert is_nvfp4(_nvfp4_args(16))
+    assert not is_nvfp4(_nvfp4_args(16), group_size=32)
+    # gs=32 (sparse paired-4:8): matches only when asked for explicitly,
+    # so dense scheme selection can never pick it up by accident.
+    assert not is_nvfp4(_nvfp4_args(32))
+    assert is_nvfp4(_nvfp4_args(32), group_size=32)
+    assert not is_nvfp4(None, group_size=32)
+
+
+@pytest.mark.parametrize(
+    ("group_size", "backend_name", "ok"),
+    [
+        (32, "PAIRED48_NVFP4", True),
+        (32, "VLLM_CUTLASS", False),  # gs=32 needs the sparse backend
+        (16, "PAIRED48_NVFP4", False),  # paired48 needs gs=32 scales
+        (16, "VLLM_CUTLASS", True),  # standard path untouched
+    ],
+)
+def test_ct_w4a4_method_group_size_gating(monkeypatch, group_size, backend_name, ok):
+    import vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors_moe.compressed_tensors_moe_w4a4_nvfp4 as m  # noqa: E501
+
+    backend = m.NvFp4MoeBackend[backend_name]
+    monkeypatch.setattr(m, "select_nvfp4_moe_backend", lambda **kw: (backend, object))
+    make = lambda: m.CompressedTensorsW4A4Nvfp4MoEMethod(  # noqa: E731
+        SimpleNamespace(), group_size=group_size
+    )
+    if ok:
+        make()
+    else:
+        with pytest.raises(ValueError, match="group_size"):
+            make()
+
+
+@pytest.mark.parametrize(
+    "fused_wheel,batched_all2all,want",
+    [
+        (True, False, Paired48Nvfp4ExpertsStandard),
+        (False, False, Paired48Nvfp4ExpertsModular),
+        (True, True, Paired48Nvfp4ExpertsModular),
+    ],
+)
+def test_gs32_auto_selects_paired48(monkeypatch, fused_wheel, batched_all2all, want):
+    """moe_backend='auto' + a group_size=32 checkpoint -> paired48, no flag.
+
+    gs=32 NVFP4 has exactly one kernel that can run it (dense kernels all
+    read per-16 scales), so auto-selection is forced. The only device gate is
+    SM100, monkeypatched here; every other is_supported_config predicate is
+    satisfied by the stub (GPU-free).
+    """
+    from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+    from vllm.model_executor.layers.fused_moe.oracle.nvfp4 import (
+        select_nvfp4_moe_backend,
+    )
+
+    monkeypatch.setattr(
+        Paired48Nvfp4ExpertsModular,
+        "_supports_current_device",
+        staticmethod(lambda: True),
+    )
+    # Token-order experts need a wheel with the fused dispatch plan / combine;
+    # batched all2alls (DeepEP-LL) always get the batched experts.
+    monkeypatch.setattr(
+        Paired48Nvfp4ExpertsStandard,
+        "_supports_current_device",
+        staticmethod(lambda: fused_wheel),
+    )
+    config = SimpleNamespace(
+        moe_backend="auto",
+        swiglu_limit=None,
+        is_act_and_mul=True,
+        activation=MoEActivation.SILU,
+        moe_parallel_config=SimpleNamespace(
+            use_batched_activation_format=batched_all2all
+        ),
+        routing_method=None,
+        router_logits_dtype=None,
+        hidden_dim=2048,
+        is_lora_enabled=False,
+    )
+    backend, cls = select_nvfp4_moe_backend(
+        config, kNvfp4Static, kNvfp4Dynamic, group_size=32
+    )
+    assert backend == NvFp4MoeBackend.PAIRED48_NVFP4
+    assert cls is want
