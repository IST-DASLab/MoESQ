@@ -0,0 +1,296 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DP x EP contract tests for the paired-4:8 NVFP4 (W4A4) MoE backend.
+
+Two GPU-free layers:
+
+  1. DeepEP-LL ``defer_input_quant`` contract (skipped unless ``deep_ep`` is
+     importable — the module imports it at top level; the tests themselves
+     inject a fake buffer, so no NIC/GPU comms happen). paired48 experts set
+     ``expects_unquantized_inputs=True``; under dp_size>1 the modular kernel
+     forwards that as ``defer_input_quant=True`` into
+     ``DeepEPLLPrepareAndFinalize.prepare``, which must dispatch RAW bf16
+     (mirroring mori.py) instead of raising / quantizing — the experts' own
+     ``quant_act`` op is the only producer of the kernel's gs=32 swizzled SFB.
+
+  2. The EPLB fail-closed guard of ``Paired48Nvfp4ExpertsModular`` (EPLB
+     shuffles the original weight params at runtime; the sparse-compressed
+     buffers derived at load would not follow).
+"""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+# ---------------------------------------------------------------------------
+# 1. DeepEP-LL defer_input_quant contract (fake buffer, no comms)
+# ---------------------------------------------------------------------------
+
+HIDDEN = 2048  # must be in DeepEPLLPrepareAndFinalize.SUPPORTED_HIDDEN_SIZES
+NUM_EXPERTS = 8
+MAX_TOKENS_PER_RANK = 16
+NUM_DISPATCHERS = 2
+
+
+class _FakeBuffer:
+    """Records low_latency_dispatch kwargs; returns a raw bf16 recv buffer."""
+
+    def __init__(self):
+        self.calls: list[dict] = []
+
+    def low_latency_dispatch(
+        self, a1, topk_ids, max_tokens_per_rank, num_experts, **kwargs
+    ):
+        self.calls.append(kwargs)
+        e_local = num_experts // NUM_DISPATCHERS
+        expert_x = a1.new_zeros(
+            (e_local, max_tokens_per_rank * NUM_DISPATCHERS, a1.size(1))
+        )
+        expert_num_tokens = torch.zeros(e_local, dtype=torch.int32)
+        return expert_x, expert_num_tokens, object(), None, lambda: None
+
+
+def _make_pf(use_fp8_dispatch: bool):
+    # Module-level import would skip the (deep_ep-free) EPLB test below;
+    # deepep_ll.py imports deep_ep at top level, so gate here instead.
+    pytest.importorskip("deep_ep", reason="DeepEP not installed")
+    from vllm.model_executor.layers.fused_moe.prepare_finalize.deepep_ll import (
+        DeepEPLLPrepareAndFinalize,
+    )
+
+    buffer = _FakeBuffer()
+    pf = DeepEPLLPrepareAndFinalize(
+        buffer=buffer,
+        max_tokens_per_rank=MAX_TOKENS_PER_RANK,
+        num_dispatchers=NUM_DISPATCHERS,
+        use_fp8_dispatch=use_fp8_dispatch,
+    )
+    return pf, buffer
+
+
+def _routing(T: int = 4, topk: int = 2):
+    a1 = torch.randn(T, HIDDEN, dtype=torch.bfloat16)
+    topk_weights = torch.rand(T, topk)
+    topk_ids = torch.randint(0, NUM_EXPERTS, (T, topk), dtype=torch.int64)
+    return a1, topk_weights, topk_ids
+
+
+# Only the attributes prepare()/_do_quant() read; a real FusedMoEQuantConfig is
+# not needed off-GPU.
+_NVFP4_QC = SimpleNamespace(
+    quant_dtype="nvfp4",
+    a1_scale=None,
+    a2_scale=None,
+    a1_gscale=torch.ones(NUM_EXPERTS),
+    per_act_token_quant=False,
+    block_shape=None,
+)
+_FP8_BLOCK_QC = SimpleNamespace(
+    quant_dtype=torch.float8_e4m3fn,
+    a1_scale=None,
+    a2_scale=None,
+    a1_gscale=None,
+    per_act_token_quant=False,
+    block_shape=[128, 128],
+)
+
+
+@pytest.mark.parametrize("quant_config", [_NVFP4_QC, _FP8_BLOCK_QC])
+def test_defer_dispatches_raw_bf16(quant_config):
+    """defer_input_quant=True must dispatch raw bf16 and skip all quant.
+
+    use_fp8_dispatch=True is the discriminating setup: it catches BOTH a
+    dropped mori-style override (dispatch would get use_fp8=True), and also
+    checks that prepare() forwards the flag to prepare_async.
+    """
+    pf, buffer = _make_pf(use_fp8_dispatch=True)
+    a1, topk_weights, topk_ids = _routing()
+
+    expert_x, expert_x_scale, meta, _ids, _w = pf.prepare(
+        a1,
+        topk_weights,
+        topk_ids,
+        NUM_EXPERTS,
+        None,  # expert_map
+        False,  # apply_router_weight_on_input
+        quant_config,
+        defer_input_quant=True,
+    )
+
+    assert len(buffer.calls) == 1
+    kwargs = buffer.calls[0]
+    assert kwargs["use_fp8"] is False, "defer must force raw (non-fp8) dispatch"
+    assert "use_nvfp4" not in kwargs, "defer must not use fused nvfp4 dispatch"
+    assert "x_global_scale" not in kwargs
+
+    # The recv buffer must come back untouched (no quant), with no scales.
+    assert expert_x.dtype == torch.bfloat16
+    assert expert_x_scale is None
+    assert meta.expert_num_tokens.dtype == torch.int32
+
+
+def test_no_defer_nvfp4_carveout_unchanged():
+    """Without defer, the nvfp4 bf16-passthrough carve-out keeps working.
+
+    This is the path FlashInferCuteDSLBatchedExperts uses
+    (VLLM_DEEPEPLL_NVFP4_DISPATCH=0): bf16 dispatch, _do_quant identity.
+    """
+    pf, buffer = _make_pf(use_fp8_dispatch=False)
+    a1, topk_weights, topk_ids = _routing()
+
+    expert_x, expert_x_scale, meta, _ids, _w = pf.prepare(
+        a1,
+        topk_weights,
+        topk_ids,
+        NUM_EXPERTS,
+        None,
+        False,
+        _NVFP4_QC,
+        defer_input_quant=False,
+    )
+
+    assert buffer.calls[0]["use_fp8"] is False
+    assert expert_x.dtype == torch.bfloat16
+    assert expert_x_scale is None
+
+
+def test_prepare_async_honors_defer():
+    """Direct prepare_async path (DBO/async schedules) honors the flag too."""
+    pf, buffer = _make_pf(use_fp8_dispatch=True)
+    a1, topk_weights, topk_ids = _routing()
+
+    hook, receiver = pf.prepare_async(
+        a1,
+        topk_weights,
+        topk_ids,
+        NUM_EXPERTS,
+        None,
+        False,
+        _NVFP4_QC,
+        defer_input_quant=True,
+    )
+    hook()
+    expert_x, expert_x_scale, meta, _ids, _w = receiver()
+
+    assert buffer.calls[0]["use_fp8"] is False
+    assert expert_x.dtype == torch.bfloat16
+    assert expert_x_scale is None
+
+
+# ---------------------------------------------------------------------------
+# 2. EPLB fail-closed guard (no deep_ep dependency, but keep one file)
+# ---------------------------------------------------------------------------
+
+
+def _experts_moe_config(enable_eplb: bool) -> SimpleNamespace:
+    return SimpleNamespace(
+        in_dtype=torch.bfloat16,
+        device="cpu",
+        num_local_experts=4,
+        # Read by the experts base __init__ (ApplyMoEActivationConfig).
+        swiglu_limit=None,
+        swiglu_alpha=None,
+        swiglu_beta=None,
+        activation_situ_beta=None,
+        activation_situ_linear_beta=None,
+        moe_parallel_config=SimpleNamespace(
+            ep_rank=0,
+            ep_size=1,
+            tp_rank=0,
+            tp_size=1,
+            enable_eplb=enable_eplb,
+        ),
+    )
+
+
+def test_eplb_fails_closed_at_init():
+    from vllm.model_executor.layers.fused_moe.config import (
+        FUSED_MOE_UNQUANTIZED_CONFIG,
+    )
+    from vllm.model_executor.layers.fused_moe.experts.paired48_nvfp4_moe import (
+        Paired48Nvfp4ExpertsModular,
+    )
+
+    with pytest.raises(NotImplementedError, match="EPLB"):
+        Paired48Nvfp4ExpertsModular(
+            moe_config=_experts_moe_config(enable_eplb=True),
+            quant_config=FUSED_MOE_UNQUANTIZED_CONFIG,
+            max_num_tokens=8,
+            num_dispatchers=1,
+        )
+    # Sanity: identical config with EPLB off constructs fine.
+    Paired48Nvfp4ExpertsModular(
+        moe_config=_experts_moe_config(enable_eplb=False),
+        quant_config=FUSED_MOE_UNQUANTIZED_CONFIG,
+        max_num_tokens=8,
+        num_dispatchers=1,
+    )
+
+
+# ---------------------------------------------------------------------------
+# 3. Capacity-bucketed tactics
+# ---------------------------------------------------------------------------
+
+
+def test_tactics_for_selects_bucket_by_capacity():
+    from vllm.model_executor.layers.fused_moe.config import (
+        FUSED_MOE_UNQUANTIZED_CONFIG,
+    )
+    from vllm.model_executor.layers.fused_moe.experts.paired48_nvfp4_moe import (
+        Paired48Nvfp4ExpertsModular,
+    )
+
+    ex = Paired48Nvfp4ExpertsModular(
+        moe_config=_experts_moe_config(enable_eplb=False),
+        quant_config=FUSED_MOE_UNQUANTIZED_CONFIG,
+        max_num_tokens=16384,
+        num_dispatchers=1,
+    )
+    # Untuned: kernel defaults everywhere.
+    assert ex.tactics_for(1) == (None, None)
+    assert ex.tactics_for(16384) == (None, None)
+
+    ex.gemm1_tactic, ex.gemm2_tactic = (1, 2, 1), (1, 2, 1)
+    ex.gemm1_tactic_small, ex.gemm2_tactic_small = (0, 2, 1), (2, 2, 1)
+    ex.small_max_n = 1024
+    assert ex.tactics_for(1) == ((0, 2, 1), (2, 2, 1))
+    assert ex.tactics_for(1024) == ((0, 2, 1), (2, 2, 1))
+    assert ex.tactics_for(1025) == ((1, 2, 1), (1, 2, 1))
+    assert ex.tactics_for(16384) == ((1, 2, 1), (1, 2, 1))
+
+    # small_max_n == 0 (no small bucket, e.g. enforce-eager): always large.
+    ex.small_max_n = 0
+    assert ex.tactics_for(1) == ((1, 2, 1), (1, 2, 1))
+
+
+def test_tactic_buckets_cover_each_capacity():
+    from vllm.model_executor.layers.fused_moe.config import (
+        FUSED_MOE_UNQUANTIZED_CONFIG,
+    )
+    from vllm.model_executor.layers.fused_moe.experts.paired48_nvfp4_moe import (
+        Paired48Nvfp4ExpertsModular,
+    )
+    from vllm.model_executor.warmup.paired_nvfp4_warmup import _capacity_buckets
+
+    assert _capacity_buckets(512, 8192) == [512, 1024, 2048, 4096, 8192]
+    assert _capacity_buckets(512, 3000) == [512, 1024, 2048, 3000]
+    assert _capacity_buckets(0, 8192) == [8192]
+    assert _capacity_buckets(8192, 8192) == [8192]
+
+    ex = Paired48Nvfp4ExpertsModular(
+        moe_config=_experts_moe_config(enable_eplb=False),
+        quant_config=FUSED_MOE_UNQUANTIZED_CONFIG,
+        max_num_tokens=8192,
+        num_dispatchers=1,
+    )
+    t = {cap: ((cap, 1, 1), (cap, 2, 1)) for cap in (512, 1024, 2048, 8192)}
+    ex.set_tactic_buckets(sorted(t.items()))
+    assert ex.tactics_for(1) == t[512]
+    assert ex.tactics_for(512) == t[512]
+    assert ex.tactics_for(513) == t[1024]
+    assert ex.tactics_for(2049) == t[8192]
+    assert ex.tactics_for(8192) == t[8192]
+    assert (ex.gemm1_tactic_small, ex.gemm2_tactic_small) == t[512]
+    assert (ex.gemm1_tactic, ex.gemm2_tactic) == t[8192]
+    assert ex.small_max_n == 512
