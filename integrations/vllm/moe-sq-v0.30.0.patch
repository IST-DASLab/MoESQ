@@ -0,0 +1,193 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""EP-dispatch tests for the capture-safe batched prepare/finalize.
+
+These run without a GPU. They validate the expert-parallel contract of
+``CaptureSafeBatchedPrepareAndFinalize`` (the prepare/finalize the paired-4:8
+NVFP4 backend is bridged onto): tokens are replicated across the EP group, each
+rank keeps only its contiguous expert shard ``[rank*E_local, (rank+1)*E_local)``,
+and the per-rank partial outputs **sum** to the single-rank (E = global) result
+— which is exactly what the runner's output all-reduce does at runtime
+(``output_is_reduced() == False``).
+"""
+
+from types import SimpleNamespace
+
+import torch
+
+from vllm.model_executor.layers.fused_moe.prepare_finalize.batched_capture_safe import (  # noqa: E501
+    CaptureSafeBatchedPrepareAndFinalize,
+)
+from vllm.model_executor.layers.fused_moe.topk_weight_and_reduce import (
+    TopKWeightAndReduceDelegate,
+)
+
+# defer_input_quant=True makes prepare() bypass quant entirely; it only reads
+# quant_dtype, so a stub suffices (no real FusedMoEQuantConfig needed off-GPU).
+_DEFER_QUANT = SimpleNamespace(quant_dtype=None)
+
+
+def _mock_expert_apply(
+    b_a1: torch.Tensor, base_expert: int, expert_w: torch.Tensor
+) -> torch.Tensor:
+    """Apply a distinct per-(global)-expert linear map to a batched buffer.
+
+    ``b_a1`` is ``[E_local, max_n, K]``; local slot ``i`` is global expert
+    ``base_expert + i`` and is multiplied by that expert's ``[K, K]`` weight.
+    Indexing by the *global* id is what makes the sharded run reproduce the
+    single-rank one (same per-expert transform, just split across ranks). The
+    caller poisons the padded rows with NaN afterwards — real experts leave
+    them unwritten (garbage) — so finalize must *drop* them, not zero-multiply.
+    """
+    e_local = b_a1.size(0)
+    out = torch.empty_like(b_a1)
+    for i in range(e_local):
+        out[i] = b_a1[i] @ expert_w[base_expert + i]
+    return out
+
+
+def _run_rank(
+    *,
+    rank: int,
+    num_local_experts: int,
+    max_num_tokens: int,
+    global_num_experts: int,
+    a1: torch.Tensor,
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    expert_w: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """prepare -> mock experts -> finalize for one EP rank. Returns (out, counts)."""
+    pf = CaptureSafeBatchedPrepareAndFinalize(
+        max_num_tokens=max_num_tokens,
+        num_local_experts=num_local_experts,
+        num_dispatchers=1,
+        rank=rank,
+    )
+    b_a1, _, meta, _, _ = pf.prepare(
+        a1,
+        topk_weights,
+        topk_ids,
+        global_num_experts,
+        None,  # expert_map: contiguous layout assumed
+        False,  # apply_router_weight_on_input
+        _DEFER_QUANT,
+        defer_input_quant=True,
+    )
+    # Per-expert capacity is min(max_num_tokens, T): a batch of T tokens fills
+    # at most T rows of any expert slot.
+    cap = min(max_num_tokens, a1.size(0))
+    assert b_a1.shape == (num_local_experts, cap, a1.size(1))
+    fused = _mock_expert_apply(b_a1, rank * num_local_experts, expert_w)
+    # Poison the padded rows. The real experts never write rows past
+    # expert_num_tokens[e] (uninitialized workspace, often NaN/Inf-patterned),
+    # and finalize gathers clamped-to-row-0 indices for dropped routings —
+    # 0.0 * NaN == NaN, so a multiply-mask would poison real tokens. NaN here
+    # proves finalize never reads those rows (only the pre-zeroed row 0).
+    rows = torch.arange(cap).unsqueeze(0)
+    fused[rows >= meta.expert_num_tokens.unsqueeze(1)] = float("nan")
+    # Mirror the experts driver's contract (run_paired_nvfp4_moe): flat row 0 is
+    # pre-zeroed before GEMM2, so finalize's clamp-to-row-0 gathers read 0.0
+    # when local expert 0 is empty. Every other padded row stays NaN.
+    if int(meta.expert_num_tokens[0]) == 0:
+        fused[0, 0] = 0.0
+    out = torch.empty(a1.size(0), a1.size(1), dtype=a1.dtype)
+    pf.finalize(
+        out,
+        fused,
+        topk_weights,
+        topk_ids,
+        False,
+        TopKWeightAndReduceDelegate(),
+    )
+    return out, meta.expert_num_tokens
+
+
+def _make_routing(T: int, topk: int, global_num_experts: int, seed: int):
+    g = torch.Generator().manual_seed(seed)
+    a1 = torch.randn(T, 8, generator=g)  # K = 8
+    expert_w = torch.randn(global_num_experts, 8, 8, generator=g)
+    # topk distinct experts per token (standard router output), global ids.
+    logits = torch.randn(T, global_num_experts, generator=g)
+    topk_weights, topk_ids = torch.topk(logits.softmax(-1), topk, dim=-1)
+    return a1, expert_w, topk_weights.contiguous(), topk_ids.int().contiguous()
+
+
+def test_ep_partials_sum_to_single_rank():
+    """R sharded ranks' partial outputs sum to the single-rank reference."""
+    T, topk, E = 7, 2, 8
+    max_n = T * topk  # worst case: every routing hits one expert
+    a1, expert_w, tw, tids = _make_routing(T, topk, E, seed=0)
+
+    # Reference: one rank owns all E experts.
+    ref_out, ref_counts = _run_rank(
+        rank=0,
+        num_local_experts=E,
+        max_num_tokens=max_n,
+        global_num_experts=E,
+        a1=a1,
+        topk_weights=tw,
+        topk_ids=tids,
+        expert_w=expert_w,
+    )
+
+    for ep_size in (2, 4, 8):
+        e_local = E // ep_size
+        summed = torch.zeros_like(ref_out)
+        per_rank_counts = []
+        for rank in range(ep_size):
+            out_r, counts_r = _run_rank(
+                rank=rank,
+                num_local_experts=e_local,
+                max_num_tokens=max_n,
+                global_num_experts=E,
+                a1=a1,
+                topk_weights=tw,
+                topk_ids=tids,
+                expert_w=expert_w,
+            )
+            summed += out_r  # simulate the runner's EP all-reduce
+            per_rank_counts.append(counts_r)
+
+        # Per-rank partials all-reduce to the full result.
+        torch.testing.assert_close(summed, ref_out, rtol=1e-5, atol=1e-5)
+        # Concatenated per-rank token counts match the single-rank counts —
+        # i.e. each routing was claimed by exactly its owning rank.
+        torch.testing.assert_close(torch.cat(per_rank_counts), ref_counts)
+
+
+def test_ep_rank_drops_non_local_experts():
+    """A rank with no locally-routed tokens contributes nothing (all zeros)."""
+    T, topk, E = 4, 1, 4
+    max_n = T * topk
+    a1, expert_w, tw, _ = _make_routing(T, topk, E, seed=1)
+    # Route every token to global expert 0 (owned only by rank 0 when E_local=2).
+    tids = torch.zeros(T, topk, dtype=torch.int)
+
+    out0, counts0 = _run_rank(
+        rank=0,
+        num_local_experts=2,
+        max_num_tokens=max_n,
+        global_num_experts=E,
+        a1=a1,
+        topk_weights=tw,
+        topk_ids=tids,
+        expert_w=expert_w,
+    )
+    out1, counts1 = _run_rank(
+        rank=1,
+        num_local_experts=2,
+        max_num_tokens=max_n,
+        global_num_experts=E,
+        a1=a1,
+        topk_weights=tw,
+        topk_ids=tids,
+        expert_w=expert_w,
+    )
+
+    # Rank 1 owns globals [2, 3]; no token routes there -> zero output, zero counts.
+    assert int(counts1.sum()) == 0
+    torch.testing.assert_close(out1, torch.zeros_like(out1))
+    # Rank 0 owns global 0 -> it carries all the work.
+    assert int(counts0[0]) == T
+    assert torch.any(out0 != 0)
