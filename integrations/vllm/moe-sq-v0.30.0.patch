index 0000000000..90761efeee
--- /dev/null
+++ b/vllm/model_executor/layers/fused_moe/experts/paired48_nvfp4_moe.py
@@ -0,0 +1,757 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""SM100 / SM120 paired-4:8 NVFP4 (W4A4) batched MoE experts.
+
+Drops the IST-DASLab paired-4:8 NVFP4 sparse grouped GEMM in as an opt-in MoE
+backend. The 4:8 paired structure is realized *inside* the kernel via CUTLASS
+structured sparsity (the weight is the sparse A operand, compressed at load).
+Weights load from a dense packed-NVFP4 (compressed-tensors) checkpoint or from
+the optional paired48 sparse storage, which is rebuilt to dense at load; either
+way the dense weight is then compressed for the kernel.
+
+Activation format is BATCHED (``[E, max_n, *]``), not ragged. This is forced by
+the sparse block-scaled collective: it addresses each expert's B/D/SFB by
+slicing one ``(N, K, L)`` tensor at ``group_idx * max_n * k`` — there are no
+per-expert B pointers and no sparse ptr-array kernel, so a ragged
+``[total_tokens, *]`` buffer (whose per-expert offset is ``cumsum(counts)``) is
+not indexable. Each expert's tokens live in a fixed ``max_n`` capacity slot,
+with the real per-expert count carried in ``expert_num_tokens[E]``.
+
+Consequently this mirrors ``FlashInferCuteDSLBatchedExperts`` (batched NVFP4;
+dispatch/combine via ``CaptureSafeBatchedPrepareAndFinalize`` on a single GPU /
+pure EP, or DeepEP low-latency under DP+EP) but swaps the dense grouped GEMM for
+the three paired-4:8 sparse ops (``paired_nvfp4_compress`` at load,
+``paired_nvfp4_quant_act`` + ``paired_nvfp4_moe_mm`` per projection).
+
+The *sparse* NVFP4 MMA (SM100 and SM120) mandates SFVecSize=32 (one UE4M3
+scale per 32 dense K elements) for BOTH operands, so activations are quantized
+by the kernel's own ``quant_act`` op, which emits the scale factors directly in
+the swizzled SFB layout ``group_mm`` reads (FlashInfer's grouped quant is
+per-16 and its swizzle does not match).
+"""
+
+import functools
+
+import torch
+
+import vllm._custom_ops as ops
+import vllm.model_executor.layers.fused_moe.modular_kernel as mk
+from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+from vllm.model_executor.layers.fused_moe.config import (
+    FusedMoEConfig,
+    FusedMoEParallelConfig,
+    FusedMoEQuantConfig,
+)
+from vllm.model_executor.layers.fused_moe.topk_weight_and_reduce import (
+    TopKWeightAndReduceDelegate,
+    TopKWeightAndReduceNoOP,
+)
+from vllm.model_executor.layers.fused_moe.utils import _resize_cache
+from vllm.model_executor.layers.quantization.utils.quant_utils import (
+    QuantKey,
+    kNvfp4Dynamic,
+    kNvfp4Static,
+)
+from vllm.model_executor.utils import replace_parameter
+from vllm.platforms import current_platform
+
+
+@functools.cache
+def _use_fused_silu_quant() -> bool:
+    """Fused SwiGLU+quant, if the installed wheel provides it: one kernel
+    replaces the 3-kernel chain ``silu_and_mul -> quant_act`` and the bf16
+    ``a2 [E, max_n, N]`` round trip, with BIT-IDENTICAL numerics (the kernel
+    replicates vLLM's exact silu rounding chain; gated by the wheel's
+    ``selftest_silu_mul_quant``). Wheels without it fall back to the unfused
+    chain. Cached: the wheel doesn't change
+    mid-process and the probe does a torch.ops attr lookup.
+    """
+    return ops.paired_nvfp4_supports_fused_silu_quant()
+
+
+def quantize_act_to_nvfp4_sfb(
+    x: torch.Tensor,
+    global_scale: torch.Tensor,
+    expert_num_tokens: torch.Tensor,
+    features: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Quantize batched activations ``[E, max_n, K]`` to NVFP4 (``b_act`` + SFB).
+
+    SINGLE switch point for the activation SF layout:
+    the kernel's own ``quant_act`` op, gs=32 (the sparse MMA's SFVecSize), with
+    the SFB swizzle byte-identical to what ``group_mm`` reads by construction.
+    ``features`` must equal the consuming GEMM's ``features`` (it parametrizes
+    the SFB layout). Rows past ``expert_num_tokens[e]`` get a benign nonzero
+    scale and an UNDEFINED ``b_act`` — the op skips their store and ``group_mm``
+    clips to ``expert_num_tokens[e]``, so they are never read. No caller-side
+    pre-fill, and no reading padded rows either.
+    """
+    return ops.paired_nvfp4_quant_act(x, global_scale, expert_num_tokens, features)
+
+
+def _run_paired_nvfp4_grouped(
+    out: torch.Tensor,
+    a_fp4: torch.Tensor,
+    a_sf: torch.Tensor,
+    w_comp: torch.Tensor,
+    w_meta: torch.Tensor,
+    w_sf: torch.Tensor,
+    alphas: torch.Tensor,
+    expert_num_tokens: torch.Tensor,
+    features: int,
+    k: int,
+    tactic: tuple[int, int, int] | None = None,
+) -> None:
+    """One batched grouped GEMM (gate_up or down). Thin shim over the kernel op.
+
+    Per expert ``e`` over its first ``expert_num_tokens[e]`` rows:
+        ``out[e, :count] = alphas[e] * (w_comp[e] @ a_fp4[e, :count])``
+    with the weight as the (compressed) sparse A operand and the activations as
+    the dense B operand. ``out`` / ``a_fp4`` are batched ``[E, max_n, *]``;
+    ``a_sf`` is in SFB layout and ``w_sf`` in SFA layout.
+    ``tactic`` = ``(config_id, cluster_m, cluster_n)`` (arch-specific ids) or None
+    for the kernel default.
+    """
+    ops.paired_nvfp4_moe_mm(
+        out,
+        w_comp,
+        w_meta,
+        w_sf,
+        a_fp4,
+        a_sf,
+        alphas,
+        expert_num_tokens,
+        features,
+        k,
+        tactic=tactic,
+    )
+
+
+def run_paired_nvfp4_moe(
+    output: torch.Tensor,
+    hidden_states: torch.Tensor,
+    layer_state: "Paired48Nvfp4ExpertsModular",
+    expert_num_tokens: torch.Tensor,
+    activation: MoEActivation,
+    workspace13: torch.Tensor,
+    workspace2: torch.Tensor,
+    max_n: int,
+    n: int,
+    k: int,
+    a1q_scale: torch.Tensor | None = None,
+) -> None:
+    """Batched driver: quant -> sparse GEMM1 -> gated act -> quant -> sparse GEMM2.
+
+    The gated activation is SwiGLU or Kimi's SiTU-GLU (``layer_state.gated_act``).
+
+    No permute/unpermute: the batched prepare/finalize already dispatched tokens
+    into the ``[E, max_n, K]`` batched layout and will combine/reduce ``output``
+    afterwards. ``expert_num_tokens[e]`` is the real (<= ``max_n``) token count
+    for expert ``e``; the kernel only writes those rows.
+
+    ``hidden_states`` is either bf16 ``[E, max_n, k]`` (unfused dispatch — quant
+    here) or, with the fused scatter+quant prepare (if the wheel provides it), uint8 FP4
+    ``[E, max_n, k/2]`` with ``a1q_scale`` = the SFB tensor — GEMM1's quant
+    already happened inside the dispatch and is skipped here.
+    """
+    if not layer_state._supports_activation(activation):
+        raise NotImplementedError(
+            f"paired48_nvfp4 does not support activation {activation} with the "
+            "installed paired_nvfp4_kernels wheel"
+        )
+    act = layer_state.gated_act
+    e = hidden_states.size(0)
+    w1_n = 2 * n  # gate + up
+
+    # GEMM1 input: pre-quantized by the fused scatter+quant dispatch, or
+    # quantize the batched bf16 activations here (NVFP4 + SFB).
+    if hidden_states.dtype == torch.uint8:
+        assert a1q_scale is not None, (
+            "uint8 (FP4) hidden_states require the SFB scale from the fused "
+            "scatter+quant prepare"
+        )
+        a1_fp4, a1_sf = hidden_states, a1q_scale
+    else:
+        a1_fp4, a1_sf = quantize_act_to_nvfp4_sfb(
+            hidden_states, layer_state.a1_gscale, expert_num_tokens, features=w1_n
+        )
+    gemm1_tactic, gemm2_tactic = layer_state.tactics_for(max_n)
+    # Untuned (autotune off, or it kept the default): the kernel's own pick for
+    # this capacity, e.g. the 256x128 tile for prefill-sized capacities on SM120.
+    if gemm1_tactic is None:
+        gemm1_tactic = ops.paired_nvfp4_suggest_tactic(max_n)
+    if gemm2_tactic is None:
+        gemm2_tactic = ops.paired_nvfp4_suggest_tactic(max_n)
+    fused_tactic = layer_state.fused_tactic_for(max_n)
+    if fused_tactic is not None:
+        # GEMM1 epilogue computes SwiGLU and GEMM2's input quantization: no bf16
+        # c1 and no separate activation kernel. Byte-identical to the path below.
+        a2_fp4, a2_sf = ops.paired_nvfp4_group_mm_swiglu_quant(
+            layer_state.w13_weight_comp,
+            layer_state.w13_weight_meta,
+            layer_state.w13_weight_sf,
+            a1_fp4,
+            a1_sf,
+            layer_state.g1_alphas,
+            expert_num_tokens,
+            layer_state.a2_gscale,
+            features=w1_n,
+            k=k,
+            tactic=fused_tactic,
+            act=act,
+        )
+    else:
+        c1 = _resize_cache(workspace2, (e, max_n, w1_n))
+        _run_paired_nvfp4_grouped(
+            c1,
+            a1_fp4,
+            a1_sf,
+            layer_state.w13_weight_comp,
+            layer_state.w13_weight_meta,
+            layer_state.w13_weight_sf,
+            layer_state.g1_alphas,
+            expert_num_tokens,
+            features=w1_n,
+            k=k,
+            tactic=gemm1_tactic,
+        )
+        # GEMM1 leaves padded rows of c1 uninitialized; neither path below emits
+        # data from rows past expert_num_tokens[e].
+        if _use_fused_silu_quant():
+            a2_fp4, a2_sf = ops.paired_nvfp4_silu_mul_quant_act(
+                c1,
+                layer_state.a2_gscale,
+                expert_num_tokens,
+                k,
+                interleaved=layer_state.w13_interleaved,
+                act=act,
+            )
+        else:
+            assert not layer_state.w13_interleaved
+            assert act[0] == "silu", "SiTU needs the fused activation quantizer"
+            a2 = _resize_cache(workspace13, (e, max_n, n))
+            torch.ops._C.silu_and_mul(a2, c1)
+            a2_fp4, a2_sf = quantize_act_to_nvfp4_sfb(
+                a2, layer_state.a2_gscale, expert_num_tokens, features=k
+            )
+
+    # finalize() clamps every dropped (out-of-range) routing to FLAT ROW 0 of this
+    # [E, max_n, K] output and then fuses its drop-mask into the topk-weight
+    # multiply (one [N, K] HBM pass instead of a separate full-width torch.where +
+    # multiply). That fusion is only NaN-safe if row 0 is finite, but row 0 is a
+    # padded slot whenever local expert 0 is empty (GEMM2 below skips it, leaving
+    # workspace garbage that may be Inf/NaN). Pre-zero that single row (K elts,
+    # negligible) so 0.0 * weight == 0.0 there; GEMM2 overwrites it when expert 0
+    # has >=1 token. Keep this in sync with finalize()'s row-0 clamp convention.
+    # The fused combine (moe_finalize) reads only kept rows, so it opts out.
+    if layer_state.prezero_row0:
+        output[0, 0].zero_()
+
+    # GEMM2 (down): features = hidden k, contraction = intermediate n. Writes the
+    # batched [E, max_n, K] output in place; finalize() does the topk reduce.
+    _run_paired_nvfp4_grouped(
+        output,
+        a2_fp4,
+        a2_sf,
+        layer_state.w2_weight_comp,
+        layer_state.w2_weight_meta,
+        layer_state.w2_weight_sf,
+        layer_state.g2_alphas,
+        expert_num_tokens,
+        features=k,
+        k=n,
+        tactic=gemm2_tactic,
+    )
+
+
+class Paired48Nvfp4ExpertsModular(mk.FusedMoEExpertsModular):
+    """SM100 / SM120 paired-4:8 NVFP4 W4A4 batched MoE experts (BatchedExperts
+    format)."""
+
+    def __init__(
+        self,
+        moe_config: FusedMoEConfig,
+        quant_config: FusedMoEQuantConfig,
+        max_num_tokens: int | None = None,
+        num_dispatchers: int | None = None,
+    ) -> None:
+        # BatchedExperts requires max_num_tokens / num_dispatchers; the Standard
+        # subclass must omit them (the base raises otherwise).
+        super().__init__(
+            moe_config=moe_config,
+            quant_config=quant_config,
+            max_num_tokens=max_num_tokens,
+            num_dispatchers=num_dispatchers,
+        )
+        # Fail at engine init, not mid-forward: the kernel's quant_act / group_mm
+        # TORCH_CHECK bf16 activations/outputs.
+        if moe_config.in_dtype != torch.bfloat16:
+            raise ValueError(
+                "moe_backend='paired48_nvfp4' requires bf16 activations (the "
+                f"sparse kernel is bf16-only); model dtype is "
+                f"{moe_config.in_dtype}"
+            )
+        # EPLB rebalancing shuffles the original weight params at runtime, but
+        # the sparse-compressed buffers (w_comp/meta/sf) derived at load would
+        # NOT be rearranged with them — fail at init, not with silent garbage.
+        if moe_config.moe_parallel_config.enable_eplb:
+            raise NotImplementedError(
+                "moe_backend='paired48_nvfp4' does not support EPLB: the "
+                "load-time sparse-compressed weights are not rearranged when "
+                "EPLB moves experts. Disable --enable-eplb."
+            )
+        self.num_experts = moe_config.num_local_experts
+        # Autotuned group_mm tactics (config_id, cluster_m, cluster_n), one per
+        # projection (GEMM1 features=2*intermediate, GEMM2 features=hidden).
+        # None = kernel default. Set by paired_nvfp4_autotune() during
+        # kernel_warmup (before CUDA-graph capture; frozen afterwards).
+        # The per-expert capacity (max_n) is dynamic -- min(max_num_tokens, T)
+        # -- and the best tactic differs between decode-sized and prefill-sized
+        # capacities, so tactics are bucketed: the *_small pair serves
+        # max_n <= small_max_n (the CUDA-graph decode range), the other pair
+        # everything larger. max_n is a host int fixed per captured graph.
+        self.gemm1_tactic: tuple[int, int, int] | None = None
+        self.gemm2_tactic: tuple[int, int, int] | None = None
+        self.gemm1_tactic_small: tuple[int, int, int] | None = None
+        self.gemm2_tactic_small: tuple[int, int, int] | None = None
+        self.small_max_n: int = 0
+        # [(capacity, (gemm1, gemm2))] ascending, from the autotuner; empty
+        # means the small/large pair above (or the kernel default) applies.
+        self.tactic_buckets: list = []
+        # [(capacity, fused GEMM1 tactic or None)] ascending, from the autotuner.
+        self.fused_tactic_buckets: list = []
+        # W13 rows are in the fused-epilogue order (set at load when usable).
+        self.w13_interleaved: bool = False
+        # Whether run_paired_nvfp4_moe pre-zeros output row 0 for the torch
+        # finalize's clamp; make_nvfp4_moe_kernel clears it when the prepare/
+        # finalize uses the fused combine, which never reads padded rows.
+        self.prezero_row0: bool = True
+
+    def tactics_for(
+        self, max_n: int
+    ) -> tuple[tuple[int, int, int] | None, tuple[int, int, int] | None]:
+        """(gemm1, gemm2) tactics for a batched capacity of ``max_n`` rows."""
+        for cap, tactics in self.tactic_buckets:
+            if max_n <= cap:
+                return tactics
+        if max_n <= self.small_max_n:
+            return self.gemm1_tactic_small, self.gemm2_tactic_small
+        return self.gemm1_tactic, self.gemm2_tactic
+
+    def tuning_capacity(self) -> int:
+        """Largest per-expert capacity a forward can use (the autotuner's top
+        bucket): the batched buffer height."""
+        assert self.max_num_tokens is not None and self.num_dispatchers is not None
+        return self.max_num_tokens * self.num_dispatchers
+
+    def fused_tactic_for(self, max_n: int) -> tuple[int, int, int] | None:
+        """Fused SwiGLU GEMM1 tactic for this capacity, or None to run GEMM1 and
+        the activation separately."""
+        for cap, tactic in self.fused_tactic_buckets:
+            if max_n <= cap:
+                return tactic
+        return None
+
+    def set_tactic_buckets(
+        self,
+        buckets: list[
+            tuple[int, tuple[tuple[int, int, int] | None, tuple[int, int, int] | None]]
+        ],
+    ) -> None:
+        """Freeze autotuned tactics: ``buckets`` is [(capacity, (gemm1, gemm2))]
+        by ascending capacity; a runtime capacity uses the first bucket that
+        covers it. The small/large attributes mirror the first/last bucket."""
+        self.tactic_buckets = list(buckets)
+        self.gemm1_tactic, self.gemm2_tactic = buckets[-1][1]
+        self.gemm1_tactic_small, self.gemm2_tactic_small = buckets[0][1]
+        self.small_max_n = buckets[0][0] if len(buckets) > 1 else 0
+
+    # ---- selection contract -------------------------------------------------
+
+    @staticmethod
+    def activation_format() -> mk.FusedMoEActivationFormat:
+        return mk.FusedMoEActivationFormat.BatchedExperts
+
+    @staticmethod
+    def _supports_current_device() -> bool:
+        # SM100 (B200/GB200) and SM120 (RTX 5090 / RTX PRO 6000). Whether the
+        # installed wheel carries this arch's kernels is checked when it loads
+        # (ops._check_paired_nvfp4_arch), with a rebuild hint.
+        p = current_platform
+        return p.is_cuda() and any(
+            p.is_device_capability_family(sm) for sm in ops.PAIRED_NVFP4_SUPPORTED_ARCHS
+        )
+
+    @staticmethod
+    def _supports_no_act_and_mul() -> bool:
+        # SiLU gate+up only for now (GEMM2's input is produced by silu_and_mul).
+        return False
+
+    @staticmethod
+    def _supports_quant_scheme(
+        weight_key: QuantKey | None,
+        activation_key: QuantKey | None,
+    ) -> bool:
+        # W4A4 NVFP4 only. There is no sparsity bit in the QuantKey; this
+        # backend is reached via moe_backend="paired48_nvfp4" or by the
+        # oracle's group_size=32 auto-select.
+        return (weight_key, activation_key) == (kNvfp4Static, kNvfp4Dynamic)
+
+    @staticmethod
+    def _supports_activation(activation: MoEActivation) -> bool:
+        # SiTU-GLU (Kimi-K3) needs a wheel whose gated-activation ops take it.
+        if activation == MoEActivation.SITU:
+            return ops.paired_nvfp4_supports_situ()
+        return activation == MoEActivation.SILU
+
+    @property
+    def gated_act(self) -> tuple[str, float, float]:
+        """(activation, beta, linear_beta) for the kernel's gated-activation ops."""
+        cfg = self.moe_config
+        return ops.paired_nvfp4_gated_act(
+            cfg.activation, cfg.activation_situ_beta, cfg.activation_situ_linear_beta
+        )
+
+    @staticmethod
+    def _supports_parallel_config(
+        moe_parallel_config: FusedMoEParallelConfig,
+    ) -> bool:
+        # EP-aware: dispatch/combine is handled by the batched prepare/finalize,
+        # so any ep_size is supported.
+        return True
+
+    @property
+    def expects_unquantized_inputs(self) -> bool:
+        # The driver does its own batched NVFP4 activation quant inside apply();
+        # prepare() defers and hands us bf16 [E, max_n, K].
+        return True
+
+    def finalize_weight_and_reduce_impl(self) -> mk.TopKWeightAndReduce:
+        # Let PrepareAndFinalize::finalize() apply topk weights + reduce.
+        return TopKWeightAndReduceDelegate()
+
+    def workspace_dtype(self, act_dtype: torch.dtype) -> torch.dtype:
+        return act_dtype
+
+    def workspace_shapes(
+        self,
+        M: int,
+        N: int,
+        K: int,
+        topk: int,
+        global_num_experts: int,
+        local_num_experts: int,
+        expert_tokens_meta: mk.ExpertTokensMetadata | None,
+        activation: MoEActivation,
+    ) -> tuple[tuple[int, ...], tuple[int, ...], tuple[int, ...]]:
+        # Batched: first dim = local experts, second = max_num_tokens (M). N is
+        # w1's out dim (2 * intermediate for gated). workspace2 holds the GEMM1
+        # gate-up output [E, M, 2*intermediate]; workspace1 holds its SiLU+mul
+        # [E, M, intermediate] (the GEMM2 quant input); output is [E, M, K].
+        workspace1 = (local_num_experts, M, N // 2)
+        workspace2 = (local_num_experts, M, N)
+        output = (local_num_experts, M, K)
+        return (workspace1, workspace2, output)
+
+    # ---- weight prep + compute ----------------------------------------------
+
+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:
+        # Fuse input scale into scale_2 in place; g1/g2_alphas alias these
+        # tensors.
+        layer.w13_weight_scale_2.data.mul_(layer.w13_input_scale)
+        layer.w2_weight_scale_2.data.mul_(layer.w2_input_scale)
+
+        # One-time sparse compression of the dense packed-NVFP4 weights into
+        # (compressed values + 4:8 metadata + SFA-layout scales), derived here at
+        # load from the dense weight. k / n are recovered from the packed
+        # (K/2, N/2) trailing dims.
+        k = layer.w13_weight.shape[2] * 2
+        n = layer.w2_weight.shape[2] * 2
+        # Stash the LOGICAL dims for the autotuner: the compressed buffers below
+        # carry alignment-padded physical dims, so k/n are unrecoverable later.
+        self.hidden_dim = k
+        self.intermediate_dim = n
+
+        # The sparse NVFP4 MMA (SM100 and SM120) mandates SFVecSize=32, so
+        # compress() requires LINEAR per-32 weight block-scales [E, out,
+        # ceil(K/32)] (it does the SFA swizzle itself). Guard against a per-16
+        # checkpoint (group_size=16) or an accidentally dense-swizzled scale —
+        # both would mis-pair scales silently.
+        assert layer.w13_weight_scale.shape[-1] == k // 32, (
+            f"paired48_nvfp4 needs per-32 linear w13 scales "
+            f"[E, 2N, K/32 == {k // 32}], got trailing dim "
+            f"{layer.w13_weight_scale.shape[-1]} — pack weights with group_size=32 "
+            f"(and ensure the scale is not swizzled)."
+        )
+        assert layer.w2_weight_scale.shape[-1] == n // 32, (
+            f"paired48_nvfp4 needs per-32 linear w2 scales "
+            f"[E, K, N/32 == {n // 32}], got trailing dim "
+            f"{layer.w2_weight_scale.shape[-1]} — pack weights with group_size=32."
+        )
+        (
+            self.w13_weight_comp,
+            self.w13_weight_meta,
+            self.w13_weight_sf,
+        ) = ops.paired_nvfp4_compress(*self._w13_for_compress(layer), k)
+        (
+            self.w2_weight_comp,
+            self.w2_weight_meta,
+            self.w2_weight_sf,
+        ) = ops.paired_nvfp4_compress(layer.w2_weight, layer.w2_weight_scale, n)
+
+        # Free the dense packed weights: from here on the kernel reads ONLY the
+        # compressed operands above (apply() touches w13/w2 solely for .shape).
+        # Replace the layer params with zero-stride SHAPE STUBS — same logical
+        # shape, so moe_problem_size / workspace sizing keep working, but one
+        # element of backing storage — reclaiming ~half the model's HBM for KV
+        # cache. Trade-offs: in-place weight reloading on a live engine becomes
+        # impossible (it already is on this path — the loaders rename
+        # *_weight_packed -> *_weight), and anything reading weight DATA
+        # post-load would see zeros; EPLB, the main such consumer, is
+        # fail-closed at __init__.
+        for name in ("w13_weight", "w2_weight"):
+            dense = getattr(layer, name)
+            stub = dense.data.new_zeros(1).as_strided(dense.shape, (0,) * dense.dim())
+            replace_parameter(layer, name, stub)
+
+        # Also free the LINEAR per-32 block scales: compress() consumed them into
+        # self.w*_weight_sf. The nvfp4 quant_config aliases them, so stub the
+        # param AND repoint the quant_config desc, else the alias keeps the full
+        # tensor resident. The stub preserves shape/dtype for shape readers.
+        for name in ("w13_weight_scale", "w2_weight_scale"):
+            sc = getattr(layer, name)
+            stub = sc.data.new_zeros(1).as_strided(sc.shape, (0,) * sc.dim())
+            replace_parameter(layer, name, stub)
+        if self.quant_config is not None:
+            self.quant_config._w1.scale = layer.w13_weight_scale
+            self.quant_config._w2.scale = layer.w2_weight_scale
+
+    def _w13_for_compress(self, layer: torch.nn.Module):
+        """W13 and its block scales, rows interleaved for the fused SwiGLU epilogue
+        when the wheel has it (the unfused activation reads the same order)."""
+        n = layer.w2_weight.shape[2] * 2
+        self.w13_interleaved = (
+            ops.paired_nvfp4_supports_fused_swiglu()
+            and self._supports_activation(self.moe_config.activation)
+            and n % 64 == 0
+        )
+        if not self.w13_interleaved:
+            return layer.w13_weight, layer.w13_weight_scale
+        perm = ops.paired_nvfp4_interleave_w13(n, layer.w13_weight.device)
+        return (
+            layer.w13_weight[:, perm].contiguous(),
+            layer.w13_weight_scale[:, perm].contiguous(),
+        )
+
+    def moe_problem_size(
+        self,
+        a1: torch.Tensor,
+        w1: torch.Tensor,
+        w2: torch.Tensor,
+        topk_ids: torch.Tensor,
+    ) -> tuple[int, int, int, int, int]:
+        """K from a1's trailing dim — DOUBLED when a1 is FP4-packed uint8 (the
+        fused scatter+quant dispatch emits [E, cap, K/2] bytes); the base
+        implementation would otherwise size fused_out / workspaces at K/2."""
+        E, M, N, K, topk = super().moe_problem_size(a1, w1, w2, topk_ids)
+        if a1.dtype == torch.uint8:
+            K *= 2
+        return E, M, N, K, topk
+
+    def apply(
+        self,
+        output: torch.Tensor,
+        hidden_states: torch.Tensor,
+        w1: torch.Tensor,
+        w2: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+        activation: MoEActivation,
+        global_num_experts: int,
+        expert_map: torch.Tensor | None,
+        a1q_scale: torch.Tensor | None,  # SFB from fused scatter+quant, else None
+        a2_scale: torch.Tensor | None,  # unused
+        workspace13: torch.Tensor | None,
+        workspace2: torch.Tensor | None,
+        expert_tokens_meta: mk.ExpertTokensMetadata | None,
+        apply_router_weight_on_input: bool,
+    ) -> None:
+        assert hidden_states.ndim == 3, "batched experts expect [E, max_n, K]"
+        assert expert_tokens_meta is not None, "batched experts need token counts"
+        expert_num_tokens = expert_tokens_meta.expert_num_tokens
+        max_n = hidden_states.size(1)
+        # uint8 = FP4-packed input from the fused scatter+quant dispatch (two
+        # logical elements per byte); bf16 = unfused dispatch, quant in-driver.
+        prequantized = hidden_states.dtype == torch.uint8
+        k = hidden_states.size(2) * (2 if prequantized else 1)
+        n = w2.shape[2] * 2  # fp4 trailing dim is packed; recover logical n
+        run_paired_nvfp4_moe(
+            output=output,
+            hidden_states=hidden_states,
+            layer_state=self,
+            expert_num_tokens=expert_num_tokens,
+            activation=activation,
+            workspace13=workspace13,
+            workspace2=workspace2,
+            max_n=max_n,
+            n=n,
+            k=k,
+            a1q_scale=a1q_scale if prequantized else None,
+        )
+
+
+def _capacity_bucket(m: int) -> int:
+    """Per-expert row capacity for ``m`` tokens: the next power of two (>= 16).
+
+    The batched operands are ``[E, cap, ...]``, so their size follows the step's token
+    count. For MoE layers run eagerly (steps past the CUDA-graph sizes) a size that
+    changes every step keeps missing the caching allocator (cudaMalloc per call, and
+    fragmentation that makes unrelated allocations miss too); powers of two repeat.
+    Capacity only bounds the rows; outputs are unchanged (rows past each expert's
+    count are never read, and every tactic gives the same bytes).
+    """
+    return max(16, 1 << (max(1, m) - 1).bit_length())
+
+
+class Paired48Nvfp4ExpertsStandard(Paired48Nvfp4ExpertsModular):
+    """Paired-4:8 NVFP4 experts on token-order (Standard format) activations.
+
+    For any Standard prepare/finalize (single GPU and TP+EP via no-DP/EP, or
+    DP+EP behind a Standard all2all such as FlashInfer's NVLink one/two-sided or
+    DeepEP high-throughput): the batched per-expert layout the sparse GEMM needs
+    is built inside apply() by the kernel's dispatch plan, and moe_finalize
+    reduces the expert output back to ``[M, K]``. Requires a kernel wheel with
+    the fused dispatch ops and the default contiguous expert placement (this
+    rank owns global experts ``[ep_rank * E, (ep_rank + 1) * E)``).
+    """
+
+    def __init__(
+        self, moe_config: FusedMoEConfig, quant_config: FusedMoEQuantConfig
+    ) -> None:
+        super().__init__(moe_config=moe_config, quant_config=quant_config)
+        pcfg = moe_config.moe_parallel_config
+        self.first_expert = pcfg.ep_rank * moe_config.num_local_experts
+        # A rank receives at most every DP rank's scheduled tokens.
+        self._tuning_capacity = moe_config.max_num_tokens * max(1, pcfg.dp_size)
+        self.prezero_row0 = False  # moe_finalize never reads padded rows
+        # Set by make_nvfp4_moe_kernel when the all2all should carry FP4: the
+        # prepare/finalize then quantizes with quant_dtype "nvfp4_p48" before
+        # dispatch and apply() receives FP4 rows plus linear scales.
+        self.prequantized_input = False
+
+    @staticmethod
+    def activation_format() -> mk.FusedMoEActivationFormat:
+        return mk.FusedMoEActivationFormat.Standard
+
+    @property
+    def expects_unquantized_inputs(self) -> bool:
+        return not self.prequantized_input
+
+    @staticmethod
+    def _supports_current_device() -> bool:
+        # workspace13 holds the GEMM2 output, so the fused SwiGLU+quant (which
+        # leaves workspace13 unused) is required as well.
+        return (
+            Paired48Nvfp4ExpertsModular._supports_current_device()
+            and ops.paired_nvfp4_supports_fused_dispatch()
+            and ops.paired_nvfp4_supports_fused_silu_quant()
+        )
+
+    def tuning_capacity(self) -> int:
+        return self._tuning_capacity
+
+    def finalize_weight_and_reduce_impl(self) -> mk.TopKWeightAndReduce:
+        return TopKWeightAndReduceNoOP()
+
+    def workspace_shapes(
+        self,
+        M: int,
+        N: int,
+        K: int,
+        topk: int,
+        global_num_experts: int,
+        local_num_experts: int,
+        expert_tokens_meta: mk.ExpertTokensMetadata | None,
+        activation: MoEActivation,
+    ) -> tuple[tuple[int, ...], tuple[int, ...], tuple[int, ...]]:
+        # Per-expert capacity cap >= M: a token routes to distinct experts.
+        # workspace13 holds the GEMM2 output [E, cap, K], workspace2 the GEMM1
+        # output [E, cap, 2 * intermediate]; output is the reduced [M, K].
+        cap = _capacity_bucket(M)
+        return (
+            (local_num_experts, cap, K),
+            (local_num_experts, cap, N),
+            (M, K),
+        )
+
+    def apply(
+        self,
+        output: torch.Tensor,
+        hidden_states: torch.Tensor,
+        w1: torch.Tensor,
+        w2: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+        activation: MoEActivation,
+        global_num_experts: int,
+        expert_map: torch.Tensor | None,
+        a1q_scale: torch.Tensor | None,
+        a2_scale: torch.Tensor | None,
+        workspace13: torch.Tensor | None,
+        workspace2: torch.Tensor | None,
+        expert_tokens_meta: mk.ExpertTokensMetadata | None,
+        apply_router_weight_on_input: bool,
+    ) -> None:
+        assert hidden_states.ndim == 2
+        E = self.num_experts
+        M = hidden_states.size(0)
+        prequantized = hidden_states.dtype == torch.uint8
+        k = hidden_states.size(1) * (2 if prequantized else 1)
+        n = w2.shape[2] * 2
+        cap = _capacity_bucket(M)
+        counts, route_dest, src_tok, src_route = ops.paired_nvfp4_dispatch_plan(
+            topk_ids.contiguous(), self.first_expert, E, cap
+        )
+        if prequantized:
+            # FP4 rows from before the all2all; the router weight, if applied
+            # on the input, was applied before quantization.
+            assert a1q_scale is not None
+            a1_fp4, a1_sf = ops.paired_nvfp4_scatter_fp4_planned(
+                hidden_states, a1q_scale.contiguous(), src_tok, counts, cap
+            )
+        else:
+            assert hidden_states.dtype == torch.bfloat16
+            w_in = (
+                topk_weights.reshape(-1).to(torch.float32).contiguous()
+                if apply_router_weight_on_input
+                else None
+            )
+            a1_fp4, a1_sf = ops.paired_nvfp4_scatter_quant_act_planned(
+                hidden_states.contiguous(),
+                src_tok,
+                src_route,
+                w_in,
+                self.a1_gscale.reshape(-1).contiguous(),
+                counts,
+                cap,
+            )
+        fused_out = _resize_cache(workspace13, (E, cap, k))
+        run_paired_nvfp4_moe(
+            output=fused_out,
+            hidden_states=a1_fp4,
+            layer_state=self,
+            expert_num_tokens=counts,
+            activation=activation,
+            workspace13=workspace13,
+            workspace2=workspace2,
+            max_n=cap,
+            n=n,
+            k=k,
+            a1q_scale=a1_sf,
+        )
+        w_out = (
+            None
+            if apply_router_weight_on_input
+            else topk_weights.to(torch.float32).contiguous()
+        )
+        ops.paired_nvfp4_moe_finalize(output, fused_out, route_dest, w_out)
