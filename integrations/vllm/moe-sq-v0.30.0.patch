+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Arch handling of the paired-4:8 NVFP4 MoE backend (SM100 and SM120).
+
+GPU-free: the device capability and the kernel package are faked, so these pin
+down which devices select the backend, which wheels are accepted on them, and
+that the default / untuned tactics come from the kernel package rather than
+SM100 constants.
+"""
+
+import sys
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+import vllm._custom_ops as ops
+from vllm.model_executor.layers.fused_moe.experts.paired48_nvfp4_moe import (
+    Paired48Nvfp4ExpertsModular,
+)
+from vllm.platforms import current_platform
+
+
+def _fake_device(monkeypatch, sm: int | None):
+    """Pretend the current CUDA device is SM``sm`` (None: no CUDA device)."""
+    monkeypatch.setattr(torch.cuda, "is_available", lambda: sm is not None)
+    if sm is not None:
+        monkeypatch.setattr(
+            torch.cuda, "get_device_capability", lambda *a, **k: divmod(sm, 10)
+        )
+
+
+def _wheel(version="0.12.0", built=(100, 120), sm=None, **attrs):
+    """A fake paired_nvfp4_kernels module (loaded_arch / built_archs API)."""
+    mod = SimpleNamespace(__version__=version, **attrs)
+    if built is not None:
+        mod.built_archs = lambda: list(built)
+        mod.loaded_arch = lambda: sm if sm in built else built[0]
+    return mod
+
+
+@pytest.mark.parametrize(
+    "sm,want", [(100, True), (103, True), (120, True), (90, False), (80, False)]
+)
+def test_supports_sm100_and_sm120_families(monkeypatch, sm, want):
+    monkeypatch.setattr(current_platform, "is_cuda", lambda: True)
+    monkeypatch.setattr(
+        current_platform,
+        "is_device_capability_family",
+        lambda capability, device_id=0: capability // 10 == sm // 10,
+    )
+    assert Paired48Nvfp4ExpertsModular._supports_current_device() is want
+
+
+@pytest.mark.parametrize(
+    "sm,built", [(100, (100,)), (120, (120,)), (100, (100, 120)), (120, (100, 120))]
+)
+def test_arch_check_accepts_matching_wheel(monkeypatch, sm, built):
+    _fake_device(monkeypatch, sm)
+    ops._check_paired_nvfp4_arch(_wheel(built=built, sm=sm), "0.12.0", False)
+
+
+def test_arch_check_rejects_sm100_only_wheel_on_sm120(monkeypatch):
+    _fake_device(monkeypatch, 120)
+    with pytest.raises(RuntimeError, match="PAIRED_NVFP4_ARCHS=120a"):
+        ops._check_paired_nvfp4_arch(_wheel(built=(100,)), "0.12.0", False)
+
+
+def test_arch_check_rejects_unsupported_arch(monkeypatch):
+    # SM121 (DGX Spark): a 120a build does not run there, and no kernel exists.
+    _fake_device(monkeypatch, 121)
+    with pytest.raises(RuntimeError, match="support SM100, SM120 only"):
+        ops._check_paired_nvfp4_arch(_wheel(), "0.12.0", False)
+
+
+def test_arch_check_pre_sm120_wheel(monkeypatch):
+    # Wheels without loaded_arch() only carry SM100 kernels.
+    old = _wheel(version="0.1.0", built=None)
+    _fake_device(monkeypatch, 100)
+    ops._check_paired_nvfp4_arch(old, "0.1.0", True)
+    _fake_device(monkeypatch, 120)
+    with pytest.raises(RuntimeError, match="only supports SM100"):
+        ops._check_paired_nvfp4_arch(old, "0.1.0", True)
+
+
+def test_arch_check_sm120_needs_pinned_version(monkeypatch):
+    # 0.11.0 carried an incomplete SM120 backend: refuse it on SM120 only.
+    _fake_device(monkeypatch, 120)
+    with pytest.raises(RuntimeError, match=ops.PAIRED_NVFP4_KERNELS_TAG):
+        ops._check_paired_nvfp4_arch(_wheel("0.11.0", sm=120), "0.11.0", True)
+    _fake_device(monkeypatch, 100)
+    ops._check_paired_nvfp4_arch(_wheel("0.11.0", sm=100), "0.11.0", True)
+
+
+def test_arch_check_skipped_without_gpu(monkeypatch):
+    _fake_device(monkeypatch, None)
+    ops._check_paired_nvfp4_arch(_wheel(built=(100,)), "0.12.0", False)
+
+
+def test_pinned_kernel_version():
+    from packaging.version import Version
+
+    assert Version(ops.PAIRED_NVFP4_KERNELS_MIN_VERSION) == Version("0.12.0")
+    assert ops.PAIRED_NVFP4_KERNELS_TAG == "v0.12.0"
+
+
+@pytest.fixture
+def fake_kernels(monkeypatch):
+    """Install a fake, already-loaded paired_nvfp4_kernels package."""
+
+    def install(mod):
+        monkeypatch.setitem(sys.modules, "paired_nvfp4_kernels", mod)
+        monkeypatch.setattr(ops, "_paired_nvfp4_loaded", True)
+        ops.paired_nvfp4_suggest_tactic.cache_clear()
+
+    yield install
+    ops.paired_nvfp4_suggest_tactic.cache_clear()
+
+
+def test_default_tactic_follows_loaded_arch(fake_kernels):
+    fake_kernels(_wheel(DEFAULT_TACTIC=(2, 1, 1)))  # SM120 wheel
+    assert ops.paired_nvfp4_default_tactic() == (2, 1, 1)
+    fake_kernels(_wheel(version="0.1.0", built=None))  # predates DEFAULT_TACTIC
+    assert ops.paired_nvfp4_default_tactic() == (0, 2, 1)
+
+
+def test_suggest_tactic(fake_kernels):
+    # SM120 rule: 256x128 (config 3) for prefill-sized capacities.
+    fake_kernels(_wheel(suggest_tactic=lambda n: (3, 1, 1) if n >= 768 else (2, 1, 1)))
+    assert ops.paired_nvfp4_suggest_tactic(1) == (2, 1, 1)
+    assert ops.paired_nvfp4_suggest_tactic(4096) == (3, 1, 1)
+    fake_kernels(_wheel(version="0.1.0", built=None))  # no suggest_tactic
+    assert ops.paired_nvfp4_suggest_tactic(4096) is None
