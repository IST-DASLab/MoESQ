+from vllm.model_executor.layers.fused_moe.config import FusedMoEQuantConfig
+from vllm.model_executor.layers.fused_moe.topk_weight_and_reduce import (
+    TopKWeightAndReduceDelegate,
+)
+
+
+class CaptureSafeBatchedPrepareAndFinalize(mk.FusedMoEPrepareAndFinalizeModular):
+    """Capture-safe batched dispatch/combine (E x max_n x K), replicated-token EP."""
+
+    def __init__(
+        self,
+        max_num_tokens: int,
+        num_local_experts: int,
+        num_dispatchers: int,
+        rank: int,
+        fuse_scatter_quant: bool = False,
+        cap_multiple: int = 1,
+        fused_dispatch: bool = False,
+    ):
+        super().__init__()
+        self.max_num_tokens = max_num_tokens
+        self.num_local_experts = num_local_experts
+        self.rank = rank
+        self.num_dispatchers_ = num_dispatchers
+        # Per-expert row capacity is rounded UP to a multiple of cap_multiple.
+        # Default 1 = the tight min(max_num_tokens, T) capacity (paired48's
+        # sparse GEMM clips tiles to per-expert counts on-device, so any cap is
+        # fine and small is best). The batched CuteDSL backend's masked grouped
+        # GEMM assumes a fixed tile-aligned M (it reads a 128-row SF-swizzle / CTA
+        # tile and walks off a smaller buffer: illegal address), so it must set
+        # this to that tile (128). The buffer
+        # ceiling (max_num_tokens) is a multiple of 128 for any real config, so
+        # the rounded cap never exceeds the experts' workspace allocation.
+        self.cap_multiple = max(1, cap_multiple)
+        # Fused dispatch-scatter + gs32 NVFP4 quant (if the paired48 wheel has it):
+        # prepare() emits the batched FP4 operands directly via
+        # ops.paired_nvfp4_scatter_quant_act — the bf16 gather + scatter buffer
+        # are never materialized and quant work scales with routed tokens, not
+        # capacity. ONLY valid for paired48 experts (the op emits the sparse
+        # kernel's gs32 SFB swizzle); the oracle bridge sets this flag
+        # backend-conditionally. Falls back to the unfused path per-call if the
+        # quant config is not nvfp4.
+        self.fuse_scatter_quant = fuse_scatter_quant
+        # Kernel dispatch plan + combine (paired48 wheel): same rows, bytes and
+        # sums as the torch path below, but only this rank's kept routings do
+        # any work, where the torch combine gathers and weights all T * topk
+        # rows. Builds on the fused scatter (same gs32 SFB).
