+    # ---- shared, deterministic dispatch plan (capture-safe) -----------------
+
+    def _dispatch_plan(self, topk_ids: torch.Tensor):
+        """Map each (token, topk-slot) routing to a row in the [E, max_n, K] buf.
+
+        ``topk_ids`` are **global** expert ids; under EP this rank owns the
+        contiguous shard ``[first_expert, first_expert + E)`` and the global id is
+        rebased to a local index ``e_idx = global - first_expert``. Routings whose
+        global id lands outside this rank's shard fall out of ``[0, E)`` and are
+        dropped (another rank handles them; the runner all-reduces the partials).
+
+        Returns (flat_tok [N], dest_global [N], in_range [N] bool,
+                 expert_num_tokens [E] int32, N, cap) where N = num_tokens * topk
+        and dest_global = e_idx*cap + within_expert_rank, or the trash row E*cap
+        for non-local (e_idx<0 / e_idx>=E) or overflow (rank>=cap) routings.
+
+        ``cap`` is the per-expert row CAPACITY of the batched buffer:
+        ``min(max_num_tokens, T)``. A batch of T tokens can land at most T rows
+        in any expert slot (the router emits distinct experts per token), so
+        the buffer never needs more. T is CPU-visible and constant per captured
+        graph (vLLM pads num_tokens to the capture size), so shapes stay
+        capture-safe — but decode graphs shrink from max_num_batched_tokens to
+        the capture size, cutting graph memory and the capacity-shaped work
+        (zero-fill / quant_act / silu) by orders of magnitude.
+        """
+        E = self.num_local_experts
+        first_expert = E * self.rank  # contiguous EP shard owned by this rank
+        T, topk = topk_ids.shape
+        cap = self._cap(T)  # per-expert row capacity
+        N = T * topk
+        device = topk_ids.device
+
+        flat_e = topk_ids.reshape(N).long() - first_expert  # global -> local idx
+        flat_tok = (
+            torch.arange(T, device=device).unsqueeze(1).expand(T, topk).reshape(N)
+        )
+        valid = (flat_e >= 0) & (flat_e < E)
+
+        # within-expert 0-based rank via a STABLE sort by expert id (deterministic,
+        # capture-safe, no atomics). Stable sort preserves flat order within each
+        # expert, so rank == "number of earlier routings to the same expert" —
+        # semantically a one-hot cumsum, but that is pathological on GPU:
+        # cumsum(0) over [N, E] hits torch's OUTER-dim scan (near-serial per
+        # column). Invalid routings are bucketed at E so they never count.
+        # int16 sort keys: values lie in [0, E] (E < 2**15 for any real MoE) and
