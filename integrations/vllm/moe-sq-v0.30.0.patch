+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Fused dispatch plan / combine of the capture-safe batched prepare/finalize.
+
+With a kernel wheel that provides ``dispatch_plan``, ``scatter_quant_act_planned``
+and ``moe_finalize``, ``CaptureSafeBatchedPrepareAndFinalize(fused_dispatch=True)``
+must produce the same expert inputs (FP4 bytes on every valid row, the whole SFB,
+the per-expert counts) and the same combined output, bit for bit, as the torch
+plan + combine path it replaces, on every EP rank.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+import vllm._custom_ops as ops
+from vllm.model_executor.layers.fused_moe.prepare_finalize.batched_capture_safe import (  # noqa: E501
+    CaptureSafeBatchedPrepareAndFinalize,
+)
+from vllm.model_executor.layers.fused_moe.topk_weight_and_reduce import (
+    TopKWeightAndReduceDelegate,
+)
+from vllm.platforms import current_platform
+
+pytestmark = pytest.mark.skipif(
+    not (
+        current_platform.is_cuda()
+        and any(
+            current_platform.is_device_capability_family(sm)
+            for sm in ops.PAIRED_NVFP4_SUPPORTED_ARCHS
+        )
+        and ops.paired_nvfp4_supports_fused_dispatch()
+    ),
+    reason="needs SM100/SM120 and a paired_nvfp4_kernels wheel with the fused "
+    "dispatch ops",
+)
+
+
+def _pf(E_local, max_num_tokens, rank, fused):
+    return CaptureSafeBatchedPrepareAndFinalize(
+        max_num_tokens=max_num_tokens,
+        num_local_experts=E_local,
+        num_dispatchers=1,
+        rank=rank,
+        fuse_scatter_quant=True,
+        fused_dispatch=fused,
+    )
+
+
+@pytest.mark.parametrize("apply_on_input", [False, True])
+@pytest.mark.parametrize(
+    "T,topk,E,ep,rank",
+    [(1, 8, 384, 8, 0), (13, 8, 384, 8, 5), (300, 8, 128, 1, 0), (2048, 8, 384, 8, 3)],
+)
+def test_fused_dispatch_matches_torch_path(T, topk, E, ep, rank, apply_on_input):
+    torch.manual_seed(T + rank)
+    K = 1024
+    E_local = E // ep
+    a1 = (torch.randn(T, K, device="cuda") * 2).to(torch.bfloat16)
+    logits = torch.randn(T, E, device="cuda")
+    tw, tids = torch.topk(logits.softmax(-1), topk, dim=-1)
+    tw, tids = tw.float().contiguous(), tids.to(torch.int32).contiguous()
+    qc = SimpleNamespace(
+        quant_dtype="nvfp4",
+        a1_gscale=torch.rand(E_local, device="cuda") + 0.5,
+    )
+
+    outs = {}
+    for fused in (False, True):
+        pf = _pf(E_local, 8192, rank, fused)
+        b, sfb, meta, _, _ = pf.prepare(
+            a1, tw, tids, E, None, apply_on_input, qc, defer_input_quant=True
+        )
+        counts = meta.expert_num_tokens
+        cap = b.size(1)
+        # Stand-in for the experts: a deterministic function of each valid row,
+        # NaN in the padded rows the real GEMM leaves unwritten.
+        fused_out = torch.full((E_local, cap, K), float("nan"), device="cuda",
+                               dtype=torch.bfloat16)
+        rows = torch.arange(cap, device="cuda")[None, :] < counts[:, None]
+        src = (b.view(torch.uint8).float()[..., : K // 2].repeat(1, 1, 2) - 7.5) / 8
+        fused_out[rows] = src[rows].to(torch.bfloat16)
+        if not fused and int(counts[0]) == 0:
+            fused_out[0, 0] = 0.0   # the driver's row-0 pre-zero for the torch path
+        out = torch.empty(T, K, device="cuda", dtype=torch.bfloat16)
+        pf.finalize(out, fused_out, tw, tids, apply_on_input,
+                    TopKWeightAndReduceDelegate())
+        outs[fused] = (b, sfb, counts, out)
+
+    (b0, s0, c0, o0), (b1, s1, c1, o1) = outs[False], outs[True]
+    torch.testing.assert_close(c1, c0, rtol=0, atol=0)
+    torch.testing.assert_close(s1, s0, rtol=0, atol=0)
+    for e in range(E_local):
+        n = int(c0[e])
+        torch.testing.assert_close(b1[e, :n], b0[e, :n], rtol=0, atol=0)
+    torch.testing.assert_close(o1, o0, rtol=0, atol=0)
+
+
+def _paired48_layer(E_global, E_local, ep_rank, K, N, topk, fmt, max_tokens):
+    """A paired48 MoE layer built through the NVFP4 oracle in the given format."""
+    import vllm.model_executor.layers.fused_moe.modular_kernel as mk
+    from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+    from vllm.model_executor.layers.fused_moe.config import (
+        FusedMoEConfig,
+        FusedMoEParallelConfig,
+        RoutingMethodType,
+    )
+    from vllm.model_executor.layers.fused_moe.oracle import nvfp4 as oracle
+    from vllm.model_executor.layers.quantization.utils.quant_utils import (
+        kNvfp4Dynamic,
+        kNvfp4Static,
+    )
+
+    pcfg = FusedMoEParallelConfig.make_no_parallel()
+    if E_local < E_global:
+        pcfg.ep_size, pcfg.ep_rank, pcfg.use_ep = E_global // E_local, ep_rank, True
+    moe = FusedMoEConfig(
+        num_experts=E_global, experts_per_token=topk, hidden_dim=K,
+        intermediate_size=N, num_local_experts=E_local, num_logical_experts=E_global,
+        moe_parallel_config=pcfg, activation=MoEActivation.SILU,
+        in_dtype=torch.bfloat16, device="cuda",
+        routing_method=RoutingMethodType.Renormalize, max_num_tokens=max_tokens,
+        moe_backend="paired48_nvfp4", intermediate_size_per_partition=N,
+    )
+    saved = oracle._paired48_activation_format
+    if fmt == "batched":
+        oracle._paired48_activation_format = (
+            lambda f: mk.FusedMoEActivationFormat.BatchedExperts
+        )
+    try:
+        backend, cls = oracle.select_nvfp4_moe_backend(
+            config=moe, weight_key=kNvfp4Static, activation_key=kNvfp4Dynamic,
+            group_size=32,
+        )
+    finally:
+        oracle._paired48_activation_format = saved
+    g = torch.Generator(device="cuda").manual_seed(0)
+
+    def packed(rows, cols):
+        w = torch.randint(0, 256, (E_local, rows, cols // 2), dtype=torch.uint8,
+                          device="cuda", generator=g)
+        chunks = w.view(E_local, rows, cols // 8, 4)
+        keep = torch.rand(chunks.shape, device="cuda", generator=g).argsort(-1) < 2
+        return (chunks * keep.to(torch.uint8)).view(E_local, rows, cols // 2)
+
+    def scales(rows, cols):
+        s = torch.rand((E_local, rows, cols // 32), device="cuda", generator=g)
+        return (s * 0.02 + 0.005).to(torch.float8_e4m3fn)
+
+    layer = torch.nn.Module()
+    layer.moe_config, layer.activation = moe, MoEActivation.SILU
+    ones = torch.ones(E_local, dtype=torch.float32, device="cuda")
+    out = oracle.convert_to_nvfp4_moe_kernel_format(
+        nvfp4_backend=backend, layer=layer, w13=packed(2 * N, K),
+        w13_scale=scales(2 * N, K), w13_scale_2=ones.clone(),
+        a13_scale=torch.ones(E_local, 2, device="cuda"), w2=packed(K, N),
+        w2_scale=scales(K, N), w2_scale_2=ones.clone(), a2_scale=ones.clone(),
+        is_act_and_mul=True,
+    )
+    names = ("w13_weight", "w13_weight_scale", "w13_weight_scale_2", None,
+             "w2_weight", "w2_weight_scale", "w2_weight_scale_2", None)
+    for name, t in zip(names, out):
+        if name:
+            layer.register_parameter(name, torch.nn.Parameter(t, requires_grad=False))
+    layer.w13_input_scale, layer.w2_input_scale = out[3], out[7]
+    qcfg = oracle.make_nvfp4_moe_quant_config(
+        backend=backend, w13_scale=layer.w13_weight_scale,
+        w2_scale=layer.w2_weight_scale, w13_scale_2=layer.w13_weight_scale_2,
+        w2_scale_2=layer.w2_weight_scale_2, a13_scale=out[3], a2_scale=out[7],
+        layer=layer,
+    )
+    kernel = oracle.make_nvfp4_moe_kernel(
+        moe_quant_config=qcfg, moe_config=moe, experts_cls=cls, backend=backend
+    )
+    kernel.fused_experts.process_weights_after_loading(layer)
+    return layer, kernel, cls
+
+
+@pytest.mark.parametrize("E_global,E_local,ep_rank", [(64, 64, 0), (128, 16, 5)])
+def test_standard_experts_match_batched(E_global, E_local, ep_rank):
+    """Token-order (Standard) paired48 experts give bit-identical outputs to the
+    batched experts behind the capture-safe bridge."""
+    from vllm.config import VllmConfig, set_current_vllm_config
+    from vllm.model_executor.layers.fused_moe import fused_topk
+    from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+    from vllm.model_executor.layers.fused_moe.experts.paired48_nvfp4_moe import (
+        Paired48Nvfp4ExpertsModular,
+        Paired48Nvfp4ExpertsStandard,
+    )
+    from vllm.v1.worker.workspace import init_workspace_manager
+
+    init_workspace_manager(torch.device("cuda", 0))
+    K, N, topk = 512, 256, 8
+    emap = None
+    if E_local < E_global:
+        emap = torch.full((E_global,), -1, dtype=torch.int32, device="cuda")
+        emap[ep_rank * E_local:(ep_rank + 1) * E_local] = torch.arange(
+            E_local, dtype=torch.int32, device="cuda")
+    results = {}
+    for fmt in ("standard", "batched"):
+        with set_current_vllm_config(VllmConfig()):
+            layer, kernel, cls = _paired48_layer(
+                E_global, E_local, ep_rank, K, N, topk, fmt, 512)
+            want = (Paired48Nvfp4ExpertsStandard if fmt == "standard"
+                    else Paired48Nvfp4ExpertsModular)
+            assert cls is want
+            g = torch.Generator(device="cuda").manual_seed(1)
+            outs = []
+            for T in (1, 7, 300):
+                x = torch.randn(T, K, dtype=torch.bfloat16, device="cuda",
+                                generator=g) * 0.1
+                logits = torch.randn(T, E_global, device="cuda", generator=g)
+                tw, ti, _ = fused_topk(x, logits, topk, renormalize=True)
+                outs.append(kernel.apply(
+                    hidden_states=x, w1=layer.w13_weight, w2=layer.w2_weight,
+                    topk_weights=tw, topk_ids=ti, activation=MoEActivation.SILU,
+                    global_num_experts=E_global, expert_map=emap,
+                    apply_router_weight_on_input=False))
+            results[fmt] = outs
+    for a, b in zip(results["standard"], results["batched"]):
+        assert torch.isfinite(a).all()
+        torch.testing.assert_close(a, b, rtol=0, atol=0)
+
+
+@pytest.mark.skipif(
+    not ops.paired_nvfp4_supports_prequant_dispatch(),
+    reason="kernel wheel without quant_rows / scatter_fp4_planned",
+)
+@pytest.mark.parametrize("E_global,E_local,ep_rank", [(64, 64, 0), (128, 16, 5)])
+def test_prequantized_dispatch_matches_bf16(E_global, E_local, ep_rank):
+    """Quantizing rows before dispatch (quant_dtype "nvfp4_p48", as the FP4
+    all2all path does) gives bit-identical outputs to quantizing in the experts,
+    when all experts share one activation global scale."""
+    import dataclasses
+
+    from vllm.config import VllmConfig, set_current_vllm_config
+    from vllm.model_executor.layers.fused_moe import fused_topk
+    from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+    from vllm.v1.worker.workspace import init_workspace_manager
+
+    init_workspace_manager(torch.device("cuda", 0))
+    K, N, topk = 512, 256, 8
+    emap = None
+    if E_local < E_global:
+        emap = torch.full((E_global,), -1, dtype=torch.int32, device="cuda")
+        emap[ep_rank * E_local:(ep_rank + 1) * E_local] = torch.arange(
+            E_local, dtype=torch.int32, device="cuda")
+    results = {}
+    for prequant in (False, True):
+        with set_current_vllm_config(VllmConfig()):
+            layer, kernel, _ = _paired48_layer(
+                E_global, E_local, ep_rank, K, N, topk, "standard", 512)
+            ex = kernel.fused_experts
+            if prequant:
+                qc = ex.quant_config
+                ex.quant_config = dataclasses.replace(
+                    qc, _a1=dataclasses.replace(qc._a1, dtype="nvfp4_p48"))
+                ex.prequantized_input = True
+            g = torch.Generator(device="cuda").manual_seed(2)
+            outs = []
+            for T in (1, 9, 300):
+                x = torch.randn(T, K, dtype=torch.bfloat16, device="cuda",
+                                generator=g) * 0.1
+                logits = torch.randn(T, E_global, device="cuda", generator=g)
+                tw, ti, _ = fused_topk(x, logits, topk, renormalize=True)
+                outs.append(kernel.apply(
+                    hidden_states=x, w1=layer.w13_weight, w2=layer.w2_weight,
+                    topk_weights=tw, topk_ids=ti, activation=MoEActivation.SILU,
+                    global_num_experts=E_global, expert_map=emap,
+                    apply_router_weight_on_input=False))
+            results[prequant] = outs
+    for a, b in zip(results[True], results[False]):
+        assert torch.isfinite(a).all()
+        torch.testing.assert_close(a, b, rtol=0, atol=0)
+
+
+@pytest.mark.skipif(
+    not ops.paired_nvfp4_supports_fused_swiglu(),
+    reason="kernel wheel without the fused SwiGLU epilogue",
+)
+@pytest.mark.parametrize("E_global,E_local,ep_rank", [(64, 64, 0), (128, 16, 5)])
+def test_fused_swiglu_gemm1_matches_unfused(E_global, E_local, ep_rank):
+    """The GEMM1 epilogue with SwiGLU + GEMM2 input quantization gives the same layer
+    output, bit for bit, as GEMM1 followed by the separate activation kernel."""
+    from vllm.config import VllmConfig, set_current_vllm_config
+    from vllm.model_executor.layers.fused_moe import fused_topk
+    from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+    from vllm.v1.worker.workspace import init_workspace_manager
+
+    init_workspace_manager(torch.device("cuda", 0))
+    K, N, topk = 512, 256, 8
+    emap = None
+    if E_local < E_global:
+        emap = torch.full((E_global,), -1, dtype=torch.int32, device="cuda")
+        emap[ep_rank * E_local:(ep_rank + 1) * E_local] = torch.arange(
+            E_local, dtype=torch.int32, device="cuda")
+    with set_current_vllm_config(VllmConfig()):
+        layer, kernel, _ = _paired48_layer(
+            E_global, E_local, ep_rank, K, N, topk, "standard", 512)
+        ex = kernel.fused_experts
+        assert ex.w13_interleaved
+        g = torch.Generator(device="cuda").manual_seed(3)
+        for T in (1, 7, 300):
+            x = torch.randn(T, K, dtype=torch.bfloat16, device="cuda",
+                            generator=g) * 0.1
+            logits = torch.randn(T, E_global, device="cuda", generator=g)
+            tw, ti, _ = fused_topk(x, logits, topk, renormalize=True)
+            outs = []
+            for fused in ((0, 2, 1), None):
+                ex.fused_tactic_buckets = [(1 << 20, fused)]
+                outs.append(kernel.apply(
+                    hidden_states=x, w1=layer.w13_weight, w2=layer.w2_weight,
+                    topk_weights=tw, topk_ids=ti, activation=MoEActivation.SILU,
+                    global_num_experts=E_global, expert_map=emap,
+                    apply_router_weight_on_input=False))
+            assert torch.isfinite(outs[1]).all()
+            torch.testing.assert_close(outs[0], outs[1], rtol=0, atol=0)
+
+
+@pytest.mark.skipif(
+    not ops.paired_nvfp4_supports_situ(),
+    reason="kernel wheel without SiTU in the gated-activation ops",
+)
+@pytest.mark.parametrize("beta,linear_beta", [(4.0, 25.0), (4.0, -1.0)])
+def test_situ_quant_matches_situ_and_mul(beta, linear_beta):
+    """paired48's SiTU activation quantizer equals vLLM's situ_and_mul followed by the
+    paired48 activation quantizer, byte for byte (Kimi-K3's activation)."""
+    E, cap, N, K = 6, 40, 3072, 3584
+    g = torch.Generator(device="cuda").manual_seed(11)
+    x2 = (torch.randn(E, cap, 2 * N, device="cuda", generator=g) * 12).to(torch.bfloat16)
+    counts = torch.randint(0, cap + 1, (E,), dtype=torch.int32, device="cuda",
+                           generator=g)
+    gscale = torch.rand(E, device="cuda", generator=g) * 0.05 + 0.01
+    a2 = torch.empty(E, cap, N, dtype=torch.bfloat16, device="cuda")
+    torch.ops._C.situ_and_mul(a2, x2, beta, linear_beta)
+    b_ref, s_ref = ops.paired_nvfp4_quant_act(a2, gscale, counts, K)
+    b, s = ops.paired_nvfp4_silu_mul_quant_act(
+        x2, gscale, counts, K, act=("situ", beta, linear_beta))
+    torch.testing.assert_close(s, s_ref, rtol=0, atol=0)
+    for e in range(E):
+        n = int(counts[e])
+        torch.testing.assert_close(b[e, :n], b_ref[e, :n], rtol=0, atol=0)
